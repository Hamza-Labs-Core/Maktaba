# Maktaba env template (Story 22.8). Copy to `.env` and edit:
#
#     cp .env.example .env
#
# `make dev` and `docker compose` both pick up `.env` automatically.
# The repo's `.gitignore` excludes `.env` so secrets stay local.
#
# If you use direnv, `direnv allow` after copying so the vars also
# export into your shell for local `go run` / `uv run` invocations.

# ---------------------------------------------------------------------------
# Datastore endpoints (matched to deploy/compose/docker-compose.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://maktaba:maktaba@localhost:5432/maktaba?sslmode=disable
CHROMA_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Service runtime knobs
# ---------------------------------------------------------------------------
# debug | info | warn | error
MAKTABA_LOG_LEVEL=debug

# Auto-run pending migrations on api start (dev convenience; prod sets false).
MAKTABA_AUTO_MIGRATE=true

# ---------------------------------------------------------------------------
# Vite HMR (web)
# ---------------------------------------------------------------------------
# The websocket URL the browser opens for hot-module-reload. `localhost`
# is right for the default Docker port mapping; override if you proxy
# through a different hostname.
VITE_HMR_HOST=localhost

# ---------------------------------------------------------------------------
# Optional — corporate proxy / mirror (Story 22.8 EC2)
# ---------------------------------------------------------------------------
# Pull container images through an internal mirror instead of Docker Hub.
# Honored by docker compose's `image:` resolution when set in your daemon
# config; documented in CONTRIBUTING.md "Behind a corporate proxy".
# MAKTABA_REGISTRY_MIRROR=https://mirror.corp.example/v2/

# Standard HTTP proxy variables; respected by go, uv, pnpm, curl.
# HTTP_PROXY=http://proxy.corp.example:3128
# HTTPS_PROXY=http://proxy.corp.example:3128
# NO_PROXY=localhost,127.0.0.1,.corp.example

# ---------------------------------------------------------------------------
# Optional — host UID for bind-mount permissions (Linux non-default)
# ---------------------------------------------------------------------------
# Dev images run as 1000:1000. If your host UID differs, set this so the
# bind-mounted source dirs stay writable from inside the container.
# MAKTABA_UID=1000
