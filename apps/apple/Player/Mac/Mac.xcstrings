{
  "sourceLanguage" : "en",
  "strings" : {
    "Cancel" : {
      "comment" : "Keeps the Player in its language: no restart",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إلغاء"
          }
        }
      }
    },
    "Enter Full Screen" : {
      "comment" : "View menu (Control-Command-F): the window on a space of its own",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدخول إلى ملء الشاشة"
          }
        }
      }
    },
    "Exit Full Screen" : {
      "comment" : "View menu (Control-Command-F) while full screen",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الخروج من ملء الشاشة"
          }
        }
      }
    },
    "It stays in its language. Try again, or quit and open it." : {
      "comment" : "Under: the Player could not restart; its language is as it was",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى بلغته الحالية. حاول مجددًا، أو أغلقه ثم افتحه."
          }
        }
      }
    },
    "Maktaba Player could not start again" : {
      "comment" : "The Player could not restart in the language chosen in Profile",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّرت إعادة تشغيل مشغل مكتبة"
          }
        }
      }
    },
    "Next Episode" : {
      "comment" : "Playback menu (N)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحلقة التالية"
          }
        }
      }
    },
    "OK" : {
      "comment" : "Closes the message that the Player could not restart",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسنًا"
          }
        }
      }
    },
    "Play/Pause" : {
      "comment" : "Playback menu (space)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
