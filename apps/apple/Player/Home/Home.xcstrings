    "Add a library under Manage libraries on the home's web page and scan it; its videos then show here." : {
      "comment" : "Home with no video, said to an admin",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مكتبة من إدارة المكتبات في صفحة الجهاز الرئيسي على الويب وافحصها، فتظهر مقاطعها هنا."
          }
        }
      }
    },
    "Continue Watching" : {
      "comment" : "Home's row of videos the person stopped part way",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع المشاهدة"
          }
        }
      }
    },
    "Could not tell the home. Try again." : {
      "comment" : "Not interested did not reach the home; the card is back",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إبلاغ الجهاز الرئيسي. أعد المحاولة."
