    "Search for a title, or for words said in a video." : {
      "comment" : "Search before anything is typed, with no recent searches",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابحث عن عنوان، أو عن كلمات قيلت في فيديو."
