        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد المطابقات: %lld"
          }
        }
      }
    },
    "Nothing matches “%@”." : {
      "comment" : "A search found nothing; the query",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء يطابق «%@»."
          }
        }
      }
    },
    "Play from %@" : {
      "comment" : "A transcript passage plays from this time",
