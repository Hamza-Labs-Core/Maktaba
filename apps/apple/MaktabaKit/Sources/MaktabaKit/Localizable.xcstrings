    "Idle" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خامل"
          }
        }
      }
    },
    "Installed. A later release's TV change replaced this one" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. حلّ محلّ هذا التغيير تغييرُ تلفاز لإصدار لاحق"
          }
        }
      }
    },
    "Installed. TV held on %@: its check failed" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. بقي التلفاز على %@: فشل فحصه"
          }
        }
      }
    },
    "Installed. TV on %@: %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. التلفاز على %1$@: %2$@"
          }
        }
      }
    },
    "Installed. The TV change failed again after its retry: see TV changes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. فشل تغيير التلفاز مرة أخرى بعد إعادة المحاولة: انظر تغييرات التلفاز"
          }
        }
      }
    },
    "Installed. The TV change goes on by itself (it waits for an approval or a quiet window); the TV runs %@ until it is on the air" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. يمضي تغيير التلفاز وحده (ينتظر موافقة أو فترة هادئة)؛ ويبقى التلفاز على %@ حتى يُبَثّ"
          }
        }
      }
    },
    "Installed. The TV change is checked again; the TV runs %@ until it passes" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. يُفحص تغيير التلفاز من جديد؛ ويبقى التلفاز على %@ حتى ينجح"
          }
        }
      }
    },
    "Installed. The TV change passed on a retry: the TV runs %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. نجح تغيير التلفاز عند إعادة المحاولة: يعمل التلفاز بالإصدار %@"
          }
        }
      }
    },
    "Installed. The TV change was dropped: the TV stayed on %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثُبِّت التحديث. أُسقط تغيير التلفاز: بقي التلفاز على %@"
