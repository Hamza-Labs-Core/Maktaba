{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ a minute" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ في الدقيقة"
          }
        }
      }
    },
    "%@ available" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإصدار %@ متاح"
          }
        }
      }
    },
    "%@ can watch with Maktaba Player. Maktaba Remote manages the home, and only its admins can use it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستطيع %@ المشاهدة بتطبيق Maktaba Player. يدير Maktaba Remote الجهاز الرئيسي، ولا يستخدمه إلا مسؤولوه."
          }
        }
      }
    },
    "%@ channel" : {
      "localizations" : {
