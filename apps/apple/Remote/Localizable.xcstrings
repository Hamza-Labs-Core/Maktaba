      }
    },
    "A stepping stone: %@ cannot be installed from this version, so %@ comes first and the next window goes on from there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إصدار وسيط: لا يمكن تثبيت %1$@ من هذا الإصدار، لذا يُثبَّت %2$@ أولًا وتكمل فترة الهدوء التالية من هناك."
          }
        }
      }
    },
