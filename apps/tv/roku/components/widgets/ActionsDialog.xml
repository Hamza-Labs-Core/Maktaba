<?xml version="1.0" encoding="utf-8" ?>
<!-- A card's actions (the * key: Roku's remote has no menu key; Epic 56 section 6.5). -->
<component name="ActionsDialog" extends="Group">
  <interface>
    <field id="item" type="node" onChange="onItem" />
    <field id="choice" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="ActionsDialog.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/components/theme.brs" />
  <script type="text/brightscript" uri="pkg:/source/i18n.brs" />
  <script type="text/brightscript" uri="pkg:/source/layout.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/net.brs" />
  <script type="text/brightscript" uri="pkg:/source/nav.brs" />
  <script type="text/brightscript" uri="pkg:/source/visualtext.brs" />
  <script type="text/brightscript" uri="pkg:/source/visualtext_tables.brs" />
  <children>
    <Rectangle width="1920" height="1080" color="0x000000B0" />
    <Rectangle id="panel" translation="[1220,0]" width="700" height="1080" color="0x131D2EFF" />
    <Label id="title" translation="[1270,120]" width="600" height="120" wrap="true" />
    <LabelList id="list" translation="[1270,300]" itemSize="[600,72]" itemSpacing="[0,12]" />
  </children>
</component>
