<!-- A series (Epic 58 story 58.12): its backdrop, Play, the season pills and the episodes. -->
<component name="SeriesScreen" extends="Screen">
  <script type="text/brightscript" uri="SeriesScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/net.brs" />
  <script type="text/brightscript" uri="pkg:/source/nav.brs" />
  <script type="text/brightscript" uri="pkg:/source/store.brs" />
  <script type="text/brightscript" uri="pkg:/source/i18n.brs" />
  <script type="text/brightscript" uri="pkg:/source/layout.brs" />
  <script type="text/brightscript" uri="pkg:/source/visualtext.brs" />
