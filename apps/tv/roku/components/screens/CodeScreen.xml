<?xml version="1.0" encoding="utf-8" ?>
<!-- Sign in with a code (Epic 58 stories 58.03, 58.12): the code large, its QR (the cloud draws it), where to approve it and how long it lasts. -->
<component name="CodeScreen" extends="Screen">
  <script type="text/brightscript" uri="CodeScreen.brs" />
  <script type="text/brightscript" uri="pkg:/components/common.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/net.brs" />
  <script type="text/brightscript" uri="pkg:/source/nav.brs" />
  <script type="text/brightscript" uri="pkg:/source/store.brs" />
  <script type="text/brightscript" uri="pkg:/source/i18n.brs" />
  <script type="text/brightscript" uri="pkg:/source/layout.brs" />
  <script type="text/brightscript" uri="pkg:/source/visualtext.brs" />
  <script type="text/brightscript" uri="pkg:/source/visualtext_tables.brs" />
  <children>
    <Label id="title" translation="[120,90]" width="1680" />
    <Label id="code" translation="[120,250]" width="1000" />
    <Poster id="qr" translation="[1300,220]" width="420" height="420" />
    <Label id="where" translation="[120,420]" width="1100" height="180" wrap="true" />
    <Label id="expires" translation="[120,640]" width="1100" />
    <Label id="state" translation="[120,720]" width="1100" height="120" wrap="true" />
    <Label id="plain" translation="[120,860]" width="1680" height="100" wrap="true" />
  </children>
