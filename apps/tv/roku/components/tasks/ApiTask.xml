<?xml version="1.0" encoding="utf-8" ?>
<!-- Every call to the signed-in home, in one Task (Epic 58 story 58.12): one refresh at a time,
     tokens saved when renewed, a sign-out reported to the scene. AI mode's own Task (follow,
     story 49.14) never refreshes: it takes the tokens the main Task renewed. -->
<component name="ApiTask" extends="Task">
  <interface>
    <field id="request" type="node" />
    <field id="signedOut" type="boolean" alwaysNotify="true" />
    <field id="tooOld" type="boolean" alwaysNotify="true" />
    <field id="tokens" type="assocarray" />
    <!-- story 49.14: AI mode's own ApiTask (MainScene's aiApi) waits as long as an answer is
         written, takes the scene's tokens before each call, and drops the call whose tag is set
         in cancel -->
    <field id="timeoutMs" type="integer" value="15000" />
    <field id="follow" type="boolean" value="false" />
    <field id="cancel" type="string" alwaysNotify="true" />
  </interface>
  <script type="text/brightscript" uri="ApiTask.brs" />
  <script type="text/brightscript" uri="pkg:/source/config.brs" />
  <script type="text/brightscript" uri="pkg:/source/net.brs" />
  <script type="text/brightscript" uri="pkg:/source/http.brs" />
  <script type="text/brightscript" uri="pkg:/source/store.brs" />
</component>
