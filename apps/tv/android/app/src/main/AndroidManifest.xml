<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the network the device is on: the homes are browsed afresh on another one -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 and later: reaching a home on the local network is a runtime permission
         (shown as «Nearby devices»); the permissions walkthrough asks for it (tv/permissions). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!-- This is a TV app: it needs Leanback and must NOT require a
         touchscreen, or Play Store will treat it as a handset app and
         hide it from the Android TV catalog. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Homes are on the local network by address (http://192.168.1.20:8088): cleartext is
         allowed, as in the phone apps. No backup or device transfer: the tokens are sealed
         with a Keystore key that never leaves this TV. -->
    <application
        android:name=".MaktabaTVApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/app_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaktabaTV">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode">

            <!-- CATEGORY_LEANBACK_LAUNCHER is what places the app on the
                 Android TV / Google TV home row. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- A home's connect link (maktaba://connect?…, Epic 42): the app asks before it
                 connects (AppSession.openLink). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maktaba" android:host="connect" />
            </intent-filter>
        </activity>
    </application>

</manifest>
