# --- JS / Capacitor ---
node_modules/
dist/
.DS_Store

# Generated native projects (created by `npx cap add`; not checked in —
# they require the platform toolchain and are reproducible from config).
# Anchored: an unanchored ios/ also hid icons/ios/, so the iOS app icon was
# never committed and the release's iOS build failed copying it.
/ios/
/android/

# --- iOS / Xcode (in case ios/ is ever partially committed) ---
ios/App/Pods/
ios/App/Podfile.lock
ios/App/build/
ios/App/App/public/
*.xcuserstate
xcuserdata/
DerivedData/
*.ipa

# --- Android / Gradle ---
android/.gradle/
android/build/
android/app/build/
android/app/src/main/assets/public/
android/local.properties
android/.idea/
*.apk
*.aab
*.keystore
*.jks
google-services.json
