<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 17 and later: reaching a home on the local network (its address, its mDNS
         announcement) is a runtime permission (the permissions walkthrough and the home picker ask for it: core/permissions). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Scanning a home's QR code, or another device's sign-in code, asked for when the person
         taps Scan. A device without a camera still installs the apps (typing works). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
</manifest>
