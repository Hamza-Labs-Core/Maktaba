<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- A video's sound goes on with the screen off (FR-39, story 48.33): the media session's
         service runs in the foreground while it plays, and the stream keeps loading. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Homes are on the local network by address (http://192.168.1.20:8088): cleartext is
         allowed, as in the Apple apps' local-network exception. No backup or device
         transfer: the tokens are sealed with a Keystore key that never leaves this device. -->
    <application
        android:name=".PlayerApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Maktaba"
        android:usesCleartextTraffic="true">

        <!-- Folding, unfolding and turning do not restart the activity: Compose lays the
             screen out again and a playing video keeps playing; so does picture in picture
             (FR-37), which going Home while a video plays opens. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation|uiMode"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A home's link or QR code: maktaba://connect?id=…&n=…&u=… (story 42.2). The app
                 asks before it connects. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maktaba" android:host="connect" />
            </intent-filter>
            <!-- A video's page: maktaba://video/{id} (FR-9, story 48.28). The page asks the home,
                 so a video this person may not see says "not available". -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="maktaba" android:host="video" />
            </intent-filter>
        </activity>

        <!-- The media session (FR-39): the notification and lock screen controls, and the
             sound with the screen off. -->
        <service
            android:name=".media.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Cast (FR-38): Google's Default Media Receiver (media/Cast.kt). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.hamzalabs.maktaba.player.media.CastOptionsProvider" />
    </application>
</manifest>
