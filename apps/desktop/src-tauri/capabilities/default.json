{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window's bundled pages: shell, dialog, fs (limited), updater, deep links, and the app's own commands (incl. Epic 36 setup).",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-read-dir",
    "shell:allow-open",
    "updater:default",
    "deep-link:default",
    "allow-app-version",
    "allow-discover-servers",
    "allow-app-state",
    "allow-setup-step",
    "allow-finish-setup",
    "allow-open-login-items",
    "allow-server-status",
    "allow-open-local-server",
    "allow-use-remote-server",
    "allow-open-external",
    "allow-host-permissions",
    "allow-open-privacy-pane",
    "allow-permissions-seen",
    "allow-big-screen-state",
    "allow-set-big-screen",
    "allow-set-big-screen-start"
  ]
}
