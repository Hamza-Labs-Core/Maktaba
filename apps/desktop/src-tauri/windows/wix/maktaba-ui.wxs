<?xml version="1.0" encoding="utf-8"?>
<!-- Written by tools/release/msi/wixui.py write (story 13.14): Maktaba's text styles for
     WixUI's words on the installer art, light on ink (the desktop tokens). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <ComponentGroup Id="MaktabaUiStyles" />
    <UI>
      <TextStyle Id="Maktaba_Bigger" FaceName="Segoe UI" Size="13" Red="232" Green="236" Blue="243" Bold="yes" />
      <TextStyle Id="Maktaba_Title" FaceName="Segoe UI" Size="9" Red="232" Green="236" Blue="243" Bold="yes" />
      <TextStyle Id="Maktaba_Light" FaceName="Segoe UI" Size="8" Red="169" Green="179" Blue="196" />
    </UI>
  </Fragment>
</Wix>
