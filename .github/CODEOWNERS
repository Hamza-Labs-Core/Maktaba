# CODEOWNERS — reviewer routing for Maktaba.
#
# `require_code_owner_reviews = true` in deploy/github/branch-protection.tf
# means every PR must be approved by an owner of every changed file's
# pattern. Keep this file alphabetized within each section.

# Default: anything unrouted falls to the core maintainers.
*                                       @Hamza-Labs-Core/maintainers

# CI + devops
/.github/                               @Hamza-Labs-Core/devops
/Makefile                               @Hamza-Labs-Core/devops
/deploy/                                @Hamza-Labs-Core/devops

# Service code
/api/                                   @Hamza-Labs-Core/backend
/streaming/                             @Hamza-Labs-Core/backend
/pipeline/                              @Hamza-Labs-Core/pipeline
# Epic 54 Phase 4: Maktaba's own stages as first-party plugins (story 54.27 §4); each plugin
# folder gets its own line as its wave adds it
/plugins/first-party/                   @Hamza-Labs-Core/pipeline
/plugins/sdk/python/                    @Hamza-Labs-Core/pipeline
/pipeline/src/maktaba_plugin_runner/    @Hamza-Labs-Core/pipeline
/api/internal/plugins/statements/       @Hamza-Labs-Core/backend
/tools/plugins/                         @Hamza-Labs-Core/pipeline

# Frontend
/web/                                   @Hamza-Labs-Core/frontend

# Shared schemas
/shared/api/                            @Hamza-Labs-Core/backend @Hamza-Labs-Core/frontend
/shared/db/migrations/                  @Hamza-Labs-Core/backend @Hamza-Labs-Core/data

# Specs and docs
/specs/                                 @Hamza-Labs-Core/maintainers
/docs/                                  @Hamza-Labs-Core/maintainers
