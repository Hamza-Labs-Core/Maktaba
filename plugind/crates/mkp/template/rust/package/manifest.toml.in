schema = 1
id = "{{id}}"
version = "0.1.0"
plugin_api = "1.0"
maktaba = ">=0.3.84"
licence = "MIT"

[strings]
name = "plugin.name"
summary = "plugin.summary"

[resources]
timeout_s = 30

# one stage, on the catalog subject: queue it from the Queues page or on a schedule
[[stage]]
name = "hello"
subject = "catalog"
export = "run-hello"
version = 1
