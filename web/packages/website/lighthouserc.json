{
  "$comment": "maktaba.tv's Lighthouse bar (story 60.04): mobile emulation and Lighthouse's default throttling, judged on the median run of each URL: performance, accessibility, best practices and SEO each 0.95 or more, cumulative layout shift 0, and 500 KB or less on the hand-made pages. The URLs and the number of runs come from scripts/lighthouse.mjs (pull requests and deploys: the hand-made pages and the representatives, 3 runs; a family whose generator changed, 1 run per page; the nightly sweep, every page, 1 run, a failing URL measured 3 more times).",
  "ci": {
    "collect": {
      "settings": {
        "formFactor": "mobile",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "chromeFlags": "--no-sandbox --headless=new --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95,
                "aggregationMethod": "median-run"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "$comment": "the hand-made pages, in both languages: scripts/lighthouse.mjs writes this pattern from build.mjs's PAGES",
          "matchingUrlPattern": "HAND_MADE",
          "assertions": {
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 512000,
                "aggregationMethod": "median-run"
              }
            ]
          }
        },
        {
          "$comment": "the pages with product screenshots (story 60.09 T05): the home page, in both languages; 60.11 adds the download page",
          "matchingUrlPattern": "^https?://[^/]+/(ar/)?$",
          "assertions": {
            "uses-responsive-images": [
              "error",
              {
                "maxLength": 0,
                "aggregationMethod": "median-run"
              }
            ],
            "modern-image-formats": [
              "error",
              {
                "maxLength": 0,
                "aggregationMethod": "median-run"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "reportFilenamePattern": "%%PATHNAME%%-%%DATETIME%%-report.%%EXTENSION%%"
    }
  }
}
