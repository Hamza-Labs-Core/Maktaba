{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@ds/*": ["design-system/*"],
      "@maktaba/tvplayer": ["packages/tvplayer/src/index.ts"],
      "@maktaba/flowchart": ["../tools/plugin-sdk/js/src/flowchart.ts"],
      "@cloud-shared/*": ["cloud/src/shared/*"]
    }
  },
  "include": ["src", "cloud/src", "admin/src", "design-system/components", "packages"],
  "exclude": [
    "dist",
    "dist-cloud",
    "dist-admin",
    "dist-install",
    "packages/install/e2e",
    "node_modules",
    "mockups",
    "wiki-app",
    "packages/devportal",
    "packages/website",
    "packages/broadcast-edge",
    "design-system/build",
    "design-system/storybook",
    "design-system/**/*.stories.tsx"
  ]
}
