# Maktaba editor config (Story 22.8). Single source for indentation +
# line endings so editor defaults don't fight gofmt / ruff / prettier.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{go,Makefile}]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{py,pyi}]
indent_size = 4
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
