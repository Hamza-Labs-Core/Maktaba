      "grant": "cast_GRANT",
      "expect": {
        "home": "https://h1.relay.maktaba.tv",
        "urls": [
          "https://h1.relay.maktaba.tv"
        ],
        "grant": "cast_GRANT",
        "video_id": "8f0c2b1e-0000-4000-8000-000000000001",
        "start_sec": 1,
        "lang": "en",
        "api_level": 1
      }
    },
    {
      "name": "only a LAN IP over plain HTTP: no address the TV can use",
      "sender_base": "http://192.168.1.20:8088",
      "discovery_urls": [
        "http://192.168.1.20:8088"
      ],
      "api_level": 1,
      "lang": "en",
      "video_id": "8f0c2b1e-0000-4000-8000-000000000001",
      "start_sec": 0,
      "grant": "cast_GRANT",
      "expect": null
    }
  ]
