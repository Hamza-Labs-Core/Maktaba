{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maktaba.dev/plugins/manifest.schema.json",
  "title": "Maktaba plugin manifest (manifest.toml), schema 1",
  "description": "Epic 54 story 54.01. The one source the Go, Rust, Python and TypeScript validators read. They read only these keywords: type, properties, additionalProperties (false), required, enum, const, pattern, minLength, maxLength, minimum, maximum, items, minItems, maxItems, uniqueItems, default; x-code names the error a failing property raises (manifest_invalid when none), x-unknown-code the error of an unknown key. Rules across fields (reserved ids, capability names, stage references, strings, settings) are in each validator's rule set, the same in all four.",
  "type": "object",
  "x-code": "manifest_invalid",
  "x-unknown-code": "manifest_unknown_key",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "plugin_api", "maktaba", "licence", "strings", "stage"],
  "properties": {
    "schema": { "type": "integer", "minimum": 1, "maximum": 1, "x-code": "manifest_schema" },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){2,5}$",
      "x-code": "manifest_bad_id"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "x-code": "manifest_bad_version"
    },
    "plugin_api": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "x-code": "manifest_bad_plugin_api" },
    "maktaba": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^ *(>=|>|<=|<|=) *[0-9]+\\.[0-9]+\\.[0-9]+ *(, *(>=|>|<=|<|=) *[0-9]+\\.[0-9]+\\.[0-9]+ *)*$",
      "x-code": "manifest_bad_range"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["any", "darwin-arm64", "windows-amd64", "linux-amd64", "linux-arm64"] },
      "default": ["any"],
      "x-code": "manifest_bad_platform"
    },
    "languages": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
      "default": [],
      "x-code": "manifest_bad_language"
    },
    "licence": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9.+-]+( (AND|OR|WITH) [A-Za-z0-9.+-]+)*$",
      "x-code": "manifest_bad_licence"
    },
    "price": {
      "type": "string",
      "pattern": "^(free|[a-z0-9][a-z0-9_.-]{0,63})$",
      "default": "free",
      "x-code": "manifest_bad_price"
    },
    "data_version": { "type": "integer", "minimum": 1, "maximum": 1000000, "default": 1, "x-code": "manifest_bad_data_version" },
    "strings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary"],
      "x-code": "manifest_bad_strings",
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$", "x-code": "manifest_bad_strings" },
        "summary": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}$", "x-code": "manifest_bad_strings" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "x-code": "manifest_bad_capability",
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 140, "pattern": "^[a-z][a-z0-9.-]*(:[a-z0-9.-]+)?$" },
          "default": [],
          "x-code": "manifest_bad_capability"
        },
        "optional": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "maxLength": 140, "pattern": "^[a-z][a-z0-9.-]*(:[a-z0-9.-]+)?$" },
          "default": [],
          "x-code": "manifest_bad_capability"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "x-code": "manifest_limit",
      "properties": {
        "memory_mb": { "type": "integer", "minimum": 1, "maximum": 1024, "default": 256, "x-code": "manifest_limit" },
        "timeout_s": { "type": "integer", "minimum": 1, "maximum": 1800, "default": 300, "x-code": "manifest_limit" },
        "fuel": { "type": ["string", "integer"], "pattern": "^default$", "minimum": 1, "maximum": 1000000000000000, "default": "default", "x-code": "manifest_limit" },
        "scratch_mb": { "type": "integer", "minimum": 0, "maximum": 512, "default": 0, "x-code": "manifest_limit" },
        "data_mb": { "type": "integer", "minimum": 0, "maximum": 1024, "default": 50, "x-code": "manifest_limit" },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8, "default": 2, "x-code": "manifest_limit" }
      }
    },
    "stage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "x-code": "manifest_bad_stage",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subject", "export", "version"],
        "x-code": "manifest_bad_stage",
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$", "x-code": "manifest_bad_stage" },
          "subject": { "type": "string", "enum": ["video", "series", "season", "library", "catalog"], "x-code": "manifest_bad_stage" },
          "export": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "x-code": "manifest_bad_stage" },
          "version": { "type": "integer", "minimum": 1, "maximum": 1000000, "x-code": "manifest_bad_stage" },
          "may_request": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
            "default": [],
            "x-code": "manifest_bad_request"
          },
          "emits": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" },
            "x-code": "manifest_bad_emit"
          },
          "trigger": {
            "type": "array",
            "maxItems": 10,
            "default": [],
            "x-code": "manifest_unknown_event",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "x-code": "manifest_bad_trigger",
              "properties": {
                "event": {
                  "type": "string",
                  "maxLength": 200,
                  "pattern": "^(plugin:[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){2,5}/)?[a-z][a-z0-9_.]{0,63}$",
                  "x-code": "manifest_unknown_event"
                },
                "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$", "x-code": "manifest_bad_trigger" }
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "array",
      "maxItems": 20,
      "x-code": "manifest_bad_event",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "subject", "payload"],
        "x-code": "manifest_bad_event",
        "properties": {
          "name": { "type": "string", "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "x-code": "manifest_bad_event" },
          "subject": { "type": "string", "enum": ["video", "series", "season", "library", "catalog"], "x-code": "manifest_bad_event" },
          "payload": { "type": "string", "pattern": "^events/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\.json$", "x-code": "manifest_bad_event" }
        }
      }
    },
    "depends": {
      "type": "array",
      "maxItems": 20,
      "x-code": "manifest_bad_depends",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["plugin", "version"],
        "x-code": "manifest_bad_depends",
        "properties": {
          "plugin": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?){2,5}$",
            "x-code": "manifest_bad_depends"
          },
          "version": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^ *(>=|>|<=|<|=) *[0-9]+\\.[0-9]+\\.[0-9]+ *(, *(>=|>|<=|<|=) *[0-9]+\\.[0-9]+\\.[0-9]+ *)*$",
            "x-code": "manifest_bad_depends"
          }
        }
      }
    },
    "schedule": {
      "type": "array",
      "maxItems": 10,
      "default": [],
      "x-code": "manifest_bad_schedule",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "every_minutes_setting"],
        "x-code": "manifest_bad_schedule",
        "properties": {
          "stage": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$", "x-code": "manifest_bad_schedule" },
          "every_minutes_setting": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$", "x-code": "manifest_bad_schedule" }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "x-code": "manifest_bad_settings",
      "properties": {
        "schema": { "type": "string", "pattern": "^ui/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\.json$", "x-code": "manifest_bad_settings" }
      }
    },
    "panel": {
      "type": "array",
      "maxItems": 10,
      "default": [],
      "x-code": "manifest_bad_panel",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["on", "schema"],
        "x-code": "manifest_bad_panel",
        "properties": {
          "on": { "type": "string", "enum": ["video", "series", "season", "library"], "x-code": "manifest_bad_panel" },
          "schema": { "type": "string", "pattern": "^ui/[A-Za-z0-9_-][A-Za-z0-9_.-]{0,99}\\.json$", "x-code": "manifest_bad_panel" }
        }
      }
    }
  }
}
