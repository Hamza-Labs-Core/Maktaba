{
  "about": "Epic 58 story 58.01: what an app does at a home. Every app's copy of the decision (Go, Kotlin, Swift, TypeScript, BrightScript) runs these cases and must reach the same verdict. home is what GET /api/discovery/home answered (an older home sends none of the three fields: both levels read 0, the floor is empty); app is the app's own build. verdict: ok (carry on), update_home or update_app.",
  "cases": [
    {
      "name": "same level: carry on",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {}},
      "app": {"name": "player", "platform": "android", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "home at level 3, oldest 2; a Roku build for level 1 must update",
      "home": {"api_level": 3, "api_level_oldest": 2, "client_floor": {}},
      "app": {"name": "tv", "platform": "roku", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_app"
    },
    {
      "name": "home at level 3, oldest 2; a build for level 2 still works",
      "home": {"api_level": 3, "api_level_oldest": 2, "client_floor": {}},
      "app": {"name": "tv", "platform": "firetv", "version": "1.2.0", "min_api_level": 1, "built_for_api_level": 2},
      "verdict": "ok"
    },
    {
      "name": "an older home without the fields reads level 0; an app built before the contract carries on",
      "home": {},
      "app": {"name": "player", "platform": "ios", "version": "1.3.0", "min_api_level": 0, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "an older home without the fields reads level 0; an app that needs level 1 asks for the home to be updated",
      "home": {},
      "app": {"name": "tv", "platform": "webos", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_home"
    },
    {
      "name": "a home rolled back below the app's oldest level",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {}},
      "app": {"name": "tv", "platform": "androidtv", "version": "2.0.0", "min_api_level": 2, "built_for_api_level": 3},
      "verdict": "update_home"
    },
    {
      "name": "a home at level 99 ahead of an app built for 1 with oldest still 1",
      "home": {"api_level": 99, "api_level_oldest": 1, "client_floor": {}},
      "app": {"name": "player", "platform": "android", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "a home at level 99, oldest 99: every app built for less updates",
      "home": {"api_level": 99, "api_level_oldest": 99, "client_floor": {}},
      "app": {"name": "player", "platform": "ios", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_app"
    },
    {
      "name": "update the home comes before update this app",
      "home": {"api_level": 2, "api_level_oldest": 2, "client_floor": {}},
      "app": {"name": "tv", "platform": "tizen", "version": "1.0.0", "min_api_level": 3, "built_for_api_level": 1},
      "verdict": "update_home"
    },
    {
      "name": "below the client floor: a 1.3.9 webOS launcher when the floor is 1.4.0",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv-web/webos": "1.4.0"}},
      "app": {"name": "tv-web", "platform": "webos", "version": "1.3.9", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_app"
    },
    {
      "name": "at the client floor exactly",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv-web/webos": "1.4.0"}},
      "app": {"name": "tv-web", "platform": "webos", "version": "1.4.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "versions compare by number, not by text: 1.10.0 is above 1.9.0",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv/roku": "1.9.0"}},
      "app": {"name": "tv", "platform": "roku", "version": "1.10.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "a missing part counts as 0: 1.4 is the floor 1.4.0",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv-web/tizen": "1.4.0"}},
      "app": {"name": "tv-web", "platform": "tizen", "version": "1.4", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "a pre-release suffix ends the number: 1.3.9-beta is below 1.4.0",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv-web/webos": "1.4.0"}},
      "app": {"name": "tv-web", "platform": "webos", "version": "1.3.9-beta", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_app"
    },
    {
      "name": "the floor names another platform: not this app's floor",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"tv-web/webos": "9.0.0"}},
      "app": {"name": "tv-web", "platform": "tizen", "version": "1.0.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "a version with no number to read is never below the floor",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"player/android": "2.0.0"}},
      "app": {"name": "player", "platform": "android", "version": "dev", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "ok"
    },
    {
      "name": "a leading v is read: v1.2.0 is below 1.3.0",
      "home": {"api_level": 1, "api_level_oldest": 1, "client_floor": {"player/ios": "1.3.0"}},
      "app": {"name": "player", "platform": "ios", "version": "v1.2.0", "min_api_level": 1, "built_for_api_level": 1},
      "verdict": "update_app"
    }
  ]
}
