#!/usr/bin/env bash
# The encrypted copy of the cloud's secrets (Epic 50 story 50.09 §3): run by the owner, on the
# owner's machine, whenever a secret changes. The secrets (a directory: the token secret, the
# entitlement key, the payment provider's and OAuth secrets, the APNs and FCM keys, the
# pgBackRest passphrases, the etcd CA key) go into one tar, encrypted with age to the owner's
# public key, and are put under secrets/ in BOTH repositories (Object Storage and R2), so a
# Hetzner-wide loss still leaves one copy. Never in plain form in a bucket. The password
# manager keeps the originals.
#
#   backup-secrets <secrets dir> <age recipient (age1...)>
# Env: REPO1_ENDPOINT, REPO1_REGION, REPO1_BUCKET, REPO1_KEY, REPO1_SECRET and the same for
# REPO2 (cloud-ha.env's pgBackRest settings); CURL_INSECURE=1 for a test endpoint.
set -euo pipefail
dir="${1:?usage: backup-secrets <secrets dir> <age recipient>}" recipient="${2:?}"
command -v age >/dev/null || { echo "backup-secrets: needs age (https://age-encryption.org)" >&2; exit 1; }
name="secrets/cloud-secrets-$(date -u +%Y%m%dT%H%M%SZ).tar.age"
out="$(mktemp)"; trap 'rm -f "${out}"' EXIT
tar -C "${dir}" -cf - . | age -r "${recipient}" >"${out}"
for r in 1 2; do
    ep="REPO${r}_ENDPOINT" rg="REPO${r}_REGION" bk="REPO${r}_BUCKET" k="REPO${r}_KEY" s="REPO${r}_SECRET"
    curl -fsS ${CURL_INSECURE:+-k} --aws-sigv4 "aws:amz:${!rg}:s3" --user "${!k}:${!s}" \
        -T "${out}" "https://${!ep}/${!bk}/${name}" >/dev/null
    echo "backup-secrets: repo${r}: ${name}"
done
