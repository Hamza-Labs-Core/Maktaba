#!/usr/bin/env bash
# Patroni's role-change callback (Epic 50 story 50.07): everything follows the database leader.
#
#   on-role-change <action> <role> <cluster>     (Patroni's callback arguments)
#
# primary (or Patroni's older name, master):
#   1. move the Floating IP to this node (Hetzner API, retried 1, 2, 4, 8 s up to 60 s; then
#      the fip_assign_failed alert, and a try every 30 s until it moves, or until Patroni
#      answers that this node no longer leads: a retry left running after a demotion would
#      take the IP back to a replica)
#   2. make sure the Floating IP is on the interface
#   3. start the cloud processes (maktaba-cloud-active.target)
# replica, standby, demoted: stop the cloud processes. The IP is never moved away: the new
# leader takes it.
#
# The database nodes (story 50.18): CLOUD_PROCESSES=off. As primary the callback moves only the
# database's Floating IP (DB_FLOATING_IP_ID: db.internal, where the apps reach PgBouncer) and
# starts nothing; the relay's Floating IP and the cloud processes are not this node's. Any other
# role drops PgBouncer's clients (KILL, then RESUME, on its admin console): a demoted primary's
# PgBouncer must not keep an app on a read-only server, and the app's next connection follows
# the Floating IP to the new primary. The Phase 1 pair sets CLOUD_PROCESSES=off too during the
# move to the database nodes (bin/migrate-db-nodes), so its cloud keeps running whoever leads.
#
# Env (/etc/maktaba/cloud-ha.env): HCLOUD_TOKEN_FILE (/etc/maktaba/hcloud-token), HCLOUD_ENDPOINT
# (https://api.hetzner.cloud/v1), FLOATING_IP_ID, FLOATING_IP, SERVER_ID (this node's Hetzner
# server id), FIP_DEV (eth0), MAKTABA_ACTIVE_CMD (how the processes start and stop, given
# start|stop; default `sudo -n systemctl <start|stop> maktaba-cloud-active.target`),
# ALERT_CMD (run with the alert's name and text; default: log only), FIP_RETRY_FOR (60),
# FIP_RETRY_EVERY (30), FIP_ADD_ADDR (1: ip addr add the Floating IP; 0 in the rehearsal),
# PATRONI_URL (http://<this node>:8008, written to cloud-ha.env by setup.sh, as leader-guard reads it),
# CLOUD_PROCESSES (leader, the default: the relay's Floating IP and the cloud processes follow
# the leader; off: neither), DB_FLOATING_IP_ID (the database's Floating IP; unset: none),
# DB_FLOATING_IP (its address, put on the interface), DB_HCLOUD_ENDPOINT (HCLOUD_ENDPOINT; the
# rehearsal's second fake), PGBOUNCER (yes: PgBouncer
# runs here), PGB_PORT (6432), PG_APP_DB (maktaba), PG_SUPERUSER_PASSWORD (PgBouncer's admin).
set -uo pipefail

env_file="${CLOUD_HA_ENV:-/etc/maktaba/cloud-ha.env}"
# shellcheck disable=SC1090  # the node's own settings
[ -r "${env_file}" ] && . "${env_file}"

action="${1:-}" role="${2:-}" cluster="${3:-}"
log() { logger -t on-role-change -- "$*" 2>/dev/null; echo "on-role-change: $*" >&2; }

endpoint="${HCLOUD_ENDPOINT:-https://api.hetzner.cloud/v1}"
retry_for="${FIP_RETRY_FOR:-60}"
retry_every="${FIP_RETRY_EVERY:-30}"
patroni="${PATRONI_URL:-http://127.0.0.1:8008}"

# the colour the last deploy left running (50.08: bin/bluegreen records it on both nodes),
# so a failover starts the same release on this node
colour="$(cat "${STATE_DIR:-/opt/maktaba-cloud}/colour" 2>/dev/null || echo blue)"
case "${colour}" in blue|green) ;; *) colour=blue ;; esac

active() { # active start|stop
    if [ -n "${MAKTABA_ACTIVE_CMD:-}" ]; then
        ${MAKTABA_ACTIVE_CMD} "$1"
    elif [ "$1" = start ]; then
        sudo -n systemctl start maktaba-cloud-active.target "maktaba-cloud-relay@${colour}.service"
    else
        sudo -n systemctl stop maktaba-cloud-active.target
    fi
}

alert() { # alert <name> <text>
    log "ALERT $1: $2"
    if [ -n "${ALERT_CMD:-}" ]; then ${ALERT_CMD} "$1" "$2" || true; fi
}

# assign_once [ip id] [endpoint]: one assign call (default: the relay's Floating IP); 0 when
# Hetzner took it (201)
assign_once() {
    local token code ip="${1:-${FLOATING_IP_ID:-}}" ep="${2:-${endpoint}}"
    token="$(cat "${HCLOUD_TOKEN_FILE:-/etc/maktaba/hcloud-token}" 2>/dev/null)" || token=""
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 -X POST \
        -H "Authorization: Bearer ${token}" -H 'Content-Type: application/json' \
        -d "{\"server\": ${SERVER_ID:?SERVER_ID is required}}" \
        "${ep}/floating_ips/${ip:?FLOATING_IP_ID is required}/actions/assign" || echo 000)"
    log "assign floating ip ${ip} to server ${SERVER_ID}: HTTP ${code}"
    [ "${code}" = 201 ] || [ "${code}" = 200 ]
}

# still_leads: false only when Patroni answers, and its answer is not 200 on /primary (503:
# this node is a replica now). No answer at all (Patroni restarting) is not a demotion: the
# retry goes on, so the IP still moves to the real leader.
still_leads() {
    local code
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 2 "${patroni}/primary" || echo 000)"
    [ "${code}" = 200 ] || [ "${code}" = 000 ]
}

# retry_ip [ip id] [endpoint]: the background retry after the window, every retry_every s until
# the IP moves or this node stops leading
retry_ip() {
    while still_leads; do
        if assign_once "$@"; then
            log "the Floating IP moved after all"
            return 0
        fi
        sleep "${retry_every}"
    done
    log "this node no longer leads: the Floating IP retry stops"
}

# move_ip [ip id] [endpoint]: the relay's Floating IP by default, or the database's
move_ip() {
    local waited=0 delay=1
    while ! assign_once "$@"; do
        if [ "${waited}" -ge "${retry_for}" ]; then
            alert fip_assign_failed "the Floating IP ${1:-${FLOATING_IP_ID:-}} did not move to ${HOSTNAME:-this node} after ${retry_for} s: see the DNS-swap runbook (docs/runbooks/cloud/hetzner-api-down.md)"
            # keep trying in the background; the cloud processes start anyway (the IP is
            # what reaches them, and the runbook can point DNS at this node meanwhile)
            retry_ip "$@" &
            # the tests and the rehearsal stop and check it by its pid
            if [ -n "${FIP_RETRY_PIDFILE:-}" ]; then echo $! >"${FIP_RETRY_PIDFILE}"; fi
            return 1
        fi
        sleep "${delay}"
        waited=$((waited + delay))
        delay=$((delay < 8 ? delay * 2 : 8))
    done
    return 0
}

# pgbouncer_kick: drop this node's PgBouncer clients and servers (KILL), and take new ones again
# (RESUME); nothing when PgBouncer doesn't run here
pgbouncer_kick() {
    [ "${PGBOUNCER:-no}" = yes ] || return 0
    local db
    for db in "${PG_APP_DB:-maktaba}" cloud_session; do
        PGPASSWORD="${PG_SUPERUSER_PASSWORD:-}" PGCONNECT_TIMEOUT=3 psql -h 127.0.0.1 -p "${PGB_PORT:-6432}" -U postgres -d pgbouncer \
            -c "KILL ${db}" -c "RESUME ${db}" >/dev/null 2>&1 || log "PgBouncer: KILL ${db} did not answer"
    done
    log "PgBouncer: clients dropped (this node does not lead)"
}

# add_addr <ip>: the Floating IP on the interface (Hetzner routes it to the holder only)
add_addr() {
    [ "${FIP_ADD_ADDR:-1}" = 1 ] && [ -n "${1:-}" ] || return 0
    [[ " $(ip -o addr show dev "${FIP_DEV:-eth0}") " == *" ${1}/"* ]] \
        || sudo -n ip addr add "${1}/32" dev "${FIP_DEV:-eth0}" || log "could not add ${1}"
}

cloud="${CLOUD_PROCESSES:-leader}"
db_endpoint="${DB_HCLOUD_ENDPOINT:-${endpoint}}"
case "${role}" in
    primary|master)
        log "${cluster}: ${action}: this node leads"
        if [ -n "${DB_FLOATING_IP_ID:-}" ]; then
            # the database's Floating IP first: the apps' writes wait on it
            move_ip "${DB_FLOATING_IP_ID}" "${db_endpoint}" || true
            add_addr "${DB_FLOATING_IP:-}"
        fi
        if [ "${cloud}" = leader ]; then
            move_ip
            add_addr "${FLOATING_IP:-}"
            active start
        else
            log "${cluster}: CLOUD_PROCESSES=${cloud}: no cloud process follows this node"
        fi
        ;;
    replica|standby|demoted|standby_leader|uninitialized)
        pgbouncer_kick
        if [ "${cloud}" = leader ]; then
            log "${cluster}: ${action}: this node is ${role}: the cloud processes stop"
            active stop
        else
            log "${cluster}: ${action}: this node is ${role}"
        fi
        ;;
    *)
        log "${cluster}: ${action}: role ${role}: nothing to do"
        ;;
esac
exit 0
