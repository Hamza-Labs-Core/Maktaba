# /etc/maktaba/relay-dns.env on the witness W (0600, owner maktaba). Story 50.16 §4.
# A database role that can SELECT the relays table only.
RELAY_DNS_DB_URL=postgres://relay_dns@10.0.0.2:5432/maktaba_cloud?sslmode=verify-full
# The Cloudflare token lives in its own file (0600): Zone -> DNS -> Edit on the zone only.
CF_API_TOKEN_FILE=/etc/maktaba/cloudflare-relay-dns.token
CF_ZONE_ID=
RELAY_DOMAIN=relay.maktaba.tv
RELAY_DNS_EVERY=15s
RELAY_DNS_PROBE_PORT=443
