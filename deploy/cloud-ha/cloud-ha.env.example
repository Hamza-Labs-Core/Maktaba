# /etc/maktaba/cloud-ha.env: one node's settings (Epic 50 story 50.07). Copy it to each of A,
# B and W, fill it in, keep it 0640 root:postgres (setup.sh sets that). Never commit a filled one.

# This node: its name (also its etcd member and Patroni member name) and private address
NODE_NAME=node-a
NODE_ADDR=10.50.0.2
PRIVATE_NET=10.50.0.0/16

# etcd: the three members, and this node's clients' view of them
ETCD_INITIAL_CLUSTER=node-a=https://10.50.0.2:2380,node-b=https://10.50.0.3:2380,witness=https://10.50.0.4:2380
ETCD_HOSTS=10.50.0.2:2379,10.50.0.3:2379,10.50.0.4:2379
# "new" for the first bring-up; "existing" when a member is re-created later
ETCD_CLUSTER_STATE=new
# where SSH may come from (the owner's and the GitHub deploy runner's addresses); empty: anywhere
SSH_FROM=

# --- A and B only ---------------------------------------------------------------------

# The Floating IP (eu-central) and this node's Hetzner server id; the token is in
# /etc/maktaba/hcloud-token (the maktaba-prod project's, 0600)
FLOATING_IP=203.0.113.10
FLOATING_IP_ID=0
SERVER_ID=0
FIP_DEV=eth0
HCLOUD_ENDPOINT=https://api.hetzner.cloud/v1

# Postgres passwords (generate each: openssl rand -hex 24); the same on A and B
PG_SUPERUSER_PASSWORD=CHANGEME
PG_REPLICATION_PASSWORD=CHANGEME
PG_REWIND_PASSWORD=CHANGEME
PG_APP_PASSWORD=CHANGEME

# WAL archiving and backups (pgBackRest, story 50.09): both repositories, each with its own
# passphrase (openssl rand -base64 48; also in the password manager: without it the backups
# cannot be read). repo1 is Hetzner Object Storage in HEL1, repo2 Cloudflare R2.
ARCHIVE_COMMAND=pgbackrest --stanza=cloud archive-push %p
REPO1_ENDPOINT=hel1.your-objectstorage.com
REPO1_REGION=hel1
REPO1_BUCKET=maktaba-prod-pg
REPO1_KEY=CHANGEME
REPO1_SECRET=CHANGEME
REPO1_CIPHER_PASS=CHANGEME
REPO2_ENDPOINT=<account id>.r2.cloudflarestorage.com
REPO2_REGION=auto
REPO2_BUCKET=maktaba-prod-pg-r2
REPO2_KEY=CHANGEME
REPO2_SECRET=CHANGEME
REPO2_CIPHER_PASS=CHANGEME
# the witness's drill compares against the live replica (read-only role)
LIVE_CONNINFO=host=10.50.0.3 port=5432 user=maktaba dbname=maktaba

# The relay's public names and the certificate (the token is in /etc/maktaba/cloudflare.token)
RELAY_DOMAIN=relay.maktaba.tv
ACME_EMAIL=ops@maktaba.tv
MAKTABA_CADDY_TAG=2.11.7-cf0.2.4
# The witness's one public site (50.10, 50.11): the probe's Pushgateway and the status page's
# view, behind the token in /etc/maktaba/witness.token (setup.sh makes it; copy it to the
# repository secret PUSHGATEWAY_TOKEN). A DNS-only A record to the witness.
WITNESS_DOMAIN=witness.maktaba.tv

# What pages the owner (50.10): run with the alert's name and text; empty: log only
ALERT_CMD=

# One node's measured capacity (story 50.14): from the latest staging load test for this pair's
# plan (docs/cloud-sizing.md). The Phase 2 alerts compare traffic and tunnels with them. Until a
# staging run, the planning figures.
RELAY_MEASURED_MBIT=300
RELAY_MEASURED_TUNNELS=5000
