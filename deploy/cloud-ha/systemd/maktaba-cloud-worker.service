[Unit]
Description=Maktaba Cloud worker (the leading node only)
PartOf=maktaba-cloud-active.target
After=patroni.service

[Service]
User=maktaba
EnvironmentFile=/etc/maktaba/cloud.env
ExecStart=/usr/local/bin/maktaba-cloud serve --role worker --config /etc/maktaba/cloud.toml
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
