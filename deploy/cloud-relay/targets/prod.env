# Production: the cloud's node until the Phase 1 pair exists (docs/cloud-single-node.md). The
# host and its key are the RELAY_HOST, RELAY_SSH_USER and RELAY_SSH_KNOWN_HOSTS repository
# variables. Only a release that passed QA's tests deploys here (cloud-deploy.yml).
DNS_ZONE=maktaba.tv
RELAY_DOMAIN=relay.maktaba.tv
API_DOMAIN=api.maktaba.tv
APP_DOMAIN=app.maktaba.tv
ACME_EMAIL=ops@maktaba.tv
RELAY_PLANS_ENFORCE=false
