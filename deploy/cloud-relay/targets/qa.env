# QA: the cloud's test node (docs/cloud-single-node.md). Its names are the staging names of
# docs/cloud-dns.md, never users'. The host and its key are the qa
# environment's secrets NODE_HOST and NODE_KNOWN_HOSTS.
DNS_ZONE=maktaba.dev
RELAY_DOMAIN=staging.relay.maktaba.dev
API_DOMAIN=staging-api.maktaba.dev
APP_DOMAIN=staging-app.maktaba.dev
ACME_EMAIL=ops@maktaba.tv
RELAY_PLANS_ENFORCE=false
# Mail (docs/cloud-mail.md): QA never writes to a stranger. Its tests' accounts (ci-e2e-*@example.com)
# are not on the list, so their mails are written and given up, and the tests confirm them by the
# operator tool; its subjects say QA. Its share of the provider's plan is small.
MAIL_ALLOW=@maktaba.tv,delivered@resend.dev,bounced@resend.dev
MAIL_SUBJECT_PREFIX=[QA]
MAIL_DAILY_LIMIT=10
MAIL_MONTHLY_LIMIT=200
