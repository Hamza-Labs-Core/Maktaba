# Maktaba Cloud Relay — Caddy with one wildcard certificate (Epic 50 story 50.02).
#
# Caddy terminates TLS and proxies cleartext to the relay on :8443. The relay routes by
# Host header (apex = control plane + WebSocket; each <slug>.<RELAY_DOMAIN> = a tunnelled
# home), so Caddy preserves the inbound Host (reverse_proxy's default).
#
# One certificate for RELAY_DOMAIN and *.RELAY_DOMAIN, by a DNS-01 challenge through the
# Cloudflare API (the image is ghcr.io/hamza-labs-core/maktaba-caddy, deploy/caddy): every
# home is covered, the certificate is on the node before any home asks, and it costs one
# issuance every ~60 days per node instead of one per home (Let's Encrypt allows 50 new
# certificates per domain per week: a standby node could never catch up per home).
# Issuers: Let's Encrypt, then ZeroSSL (Caddy's defaults, with the email below); the
# maktaba.tv CAA records allow both (docs/cloud-dns.md).
#
# Env (compose passes them from .env): RELAY_DOMAIN, ACME_EMAIL, CF_API_TOKEN (a Cloudflare
# API token with Zone -> DNS -> Edit on the zone only).

{
	email {$ACME_EMAIL}

	# The transition from per-home certificates (story 50.02 §3): a name outside the
	# wildcard (none is expected) still gets an on-demand certificate, only when the
	# relay's /v1/relay/tls-ask approves it. Removed one release after no on-demand
	# issuance is logged for 7 days.
	on_demand_tls {
		ask http://maktaba-cloud:8443/v1/relay/tls-ask
	}
}

{$RELAY_DOMAIN}, *.{$RELAY_DOMAIN} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		# answer the challenge from public resolvers, not the node's own
		resolvers 1.1.1.1 9.9.9.9
	}
	encode zstd gzip
	reverse_proxy maktaba-cloud:8443 {
		flush_interval -1
	}
}

# The transition's catch-all, below the wildcard (more specific sites win).
https:// {
	tls {
		on_demand
	}
	encode zstd gzip
	reverse_proxy maktaba-cloud:8443 {
		flush_interval -1
	}
}
