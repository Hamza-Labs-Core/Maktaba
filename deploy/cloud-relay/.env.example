# Maktaba Cloud Relay — environment template.
#
#   cp .env.example .env  &&  edit  &&  docker compose --env-file .env up -d
#
# setup.sh fills in the generated secrets (token secret, entitlement
# key, postgres password) automatically. Everything marked REQUIRED
# below must be set for the relay to start.
#
# DO NOT commit your filled-in .env. Keep it 0600, owned by the maktaba
# user (setup.sh enforces this).

# =====================================================================
# Deployment basics (REQUIRED)
# =====================================================================

# Your relay domain. A wildcard DNS A record (*.RELAY_DOMAIN) AND an
# apex A record (RELAY_DOMAIN) must both point at this VPS's public IP.
# Drives both Caddy's TLS and the relay's subdomain routing
# (MAKTABA_CLOUD_RELAY_PUBLIC_HOST is set from this in compose).
RELAY_DOMAIN=relay.example.com

# Email Let's Encrypt uses for expiry notices / account recovery.
ACME_EMAIL=ops@example.com

# Image tag to deploy. Pin to a release (e.g. v1.4.0) in production;
# `latest` is fine for first bring-up.
MAKTABA_CLOUD_TAG=latest

# =====================================================================
# Relay core config (REQUIRED)
# =====================================================================

# Listen address inside the container. Caddy proxies to :8443; leave as
# the default unless you also change the Caddyfile + healthcheck.
MAKTABA_CLOUD_LISTEN_ADDR=0.0.0.0:8443

# Postgres connection string. Host MUST be `postgres` (the compose
# service name). Keep the password in sync with POSTGRES_PASSWORD below.
# sslmode=disable is safe here: the link never leaves the internal
# compose network.
MAKTABA_CLOUD_DB_URL=postgres://maktaba:CHANGEME@postgres:5432/maktaba?sslmode=disable

# Redis connection string. Host MUST be `redis`. Default matches the
# bundled redis service; override only for an external Redis.
MAKTABA_CLOUD_REDIS_URL=redis://redis:6379/0

# Public base URL clients use to reach this deployment (https + apex).
MAKTABA_CLOUD_PUBLIC_URL=https://relay.example.com

# Access-token HMAC secret, >= 32 bytes. GENERATED by setup.sh if empty.
# Manual: openssl rand -base64 48
MAKTABA_CLOUD_TOKEN_SECRET=

# =====================================================================
# Postgres container (REQUIRED — must match MAKTABA_CLOUD_DB_URL)
# =====================================================================
POSTGRES_USER=maktaba
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=maktaba

# =====================================================================
# api-role secrets — OPTIONAL for a pure relay deployment.
#
# The relay role ignores everything below. They are documented here
# because the same image/stack can run `--role api`. Secrets with a
# MAKTABA_CLOUD_* env override (Stripe, Google client secret) are wired
# straight through by compose. The id/path-based ones have no env
# override — supply them via a mounted cloud.toml (see README), using
# the in-container paths under /etc/maktaba/cloud/secrets.
# =====================================================================

# Stripe (billing) — wired via env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth — secret wired via env; client id goes in cloud.toml.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple OAuth (Sign in with Apple) — all go in cloud.toml.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=

# Push credentials — paths point INSIDE the container, under the
# read-only ./secrets mount (/etc/maktaba/cloud/secrets/...). Configured
# in cloud.toml as apns.key_path / fcm.service_account_path.
APNS_KEY_PATH=/etc/maktaba/cloud/secrets/apns.p8
FCM_SERVICE_ACCOUNT_PATH=/etc/maktaba/cloud/secrets/fcm-service-account.json

# Ed25519 entitlement signing key (raw 32-byte seed, base64). GENERATED
# by setup.sh into ./secrets/entitlement.key. Configured in cloud.toml
# as entitlement.private_key_path. Used by --role api only.
ENTITLEMENT_KEY_PATH=/etc/maktaba/cloud/secrets/entitlement.key
