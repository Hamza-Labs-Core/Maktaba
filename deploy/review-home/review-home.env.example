# The review home's settings (deploy/review-home/README.md). setup.sh copies this file to
# /opt/maktaba-review/.env (mode 0600) on its first run. No secret goes here: the reviewer
# passwords stay in the release secrets and reach seed.sh through the environment.

# the home's direct HTTPS name (a DNS-only A record to this machine, docs/cloud-dns.md)
REVIEW_DOMAIN=review.maktaba.tv
# Let's Encrypt's account email for the certificate
ACME_EMAIL=CHANGEME
# where content.py fetch puts the content set
REVIEW_MEDIA=/srv/review-media
# The cloud plan of the review home's account: the lowest plan that includes the relay, so a
# reviewer's streams go through the relay at that plan's cap (cloud/internal/billing
# LowestRelayPlan; its test fails when this differs). Set on the account in the operator console.
REVIEW_HOME_PLAN=basic
