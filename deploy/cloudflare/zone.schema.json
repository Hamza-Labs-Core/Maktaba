{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maktaba.dev/schemas/cloudflare-zone.json",
  "title": "The maktaba.tv zone's security settings (Epic 50, story 50.30)",
  "description": "Checked by tools/cloudflare/zone.mjs check, which also enforces what a schema can't: the plan's rule counts, each expression's fields, and no relay host.",
  "type": "object",
  "additionalProperties": false,
  "required": ["zone", "plan", "settings", "super_bot_fight_mode", "managed_rules", "custom_rules", "rate_limits", "exceptions", "responses"],
  "properties": {
    "$schema": { "type": "string" },
    "zone": { "const": "maktaba.tv" },
    "plan": { "enum": ["free", "pro"] },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ssl": { "enum": ["off", "flexible", "full", "strict"] },
        "min_tls_version": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
        "tls_1_3": { "enum": ["on", "off", "zrt"] },
        "always_use_https": { "enum": ["on", "off"] },
        "automatic_https_rewrites": { "enum": ["on", "off"] },
        "opportunistic_encryption": { "enum": ["on", "off"] },
        "browser_check": { "enum": ["on", "off"] },
        "security_level": { "enum": ["off", "essentially_off", "low", "medium", "high", "under_attack"] }
      }
    },
    "super_bot_fight_mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": { "value": { "enum": ["on", "off"] }, "reason": { "type": "string", "minLength": 10 } }
    },
    "managed_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cloudflare": { "type": "object", "additionalProperties": false, "properties": { "enabled": { "type": "boolean" } } },
        "owasp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "paranoia_level", "score_threshold", "action", "reason"],
          "properties": {
            "enabled": { "type": "boolean" },
            "paranoia_level": { "enum": [1, 2, 3, 4] },
            "score_threshold": { "enum": ["low", "medium", "high"] },
            "action": { "enum": ["block", "log", "managed_challenge"] },
            "owasp_block_from": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "reason": { "type": "string", "minLength": 10 }
          }
        }
      }
    },
    "custom_rules": { "type": "array", "items": { "$ref": "#/$defs/rule" } },
    "rate_limits": { "type": "array", "items": { "$ref": "#/$defs/rateLimit" } },
    "exceptions": { "type": "array", "items": { "$ref": "#/$defs/exception" } },
    "responses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "body"],
        "properties": {
          "status": { "type": "integer" },
          "body": {
            "type": "object",
            "required": ["error", "message", "message_ar"],
            "properties": { "error": { "type": "string" }, "message": { "type": "string" }, "message_ar": { "type": "string" } }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reason", "expression", "action"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "reason": { "type": "string", "minLength": 10 },
        "expression": { "type": "string" },
        "action": { "enum": ["block", "managed_challenge", "challenge", "js_challenge", "log"] },
        "response": { "type": "string" },
        "enabled": { "type": "boolean" }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "reason", "expression", "action", "requests_per_period", "period", "mitigation_timeout"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "reason": { "type": "string", "minLength": 10 },
        "expression": { "type": "string" },
        "action": { "enum": ["block", "managed_challenge", "challenge", "js_challenge", "log"] },
        "response": { "type": "string" },
        "enabled": { "type": "boolean" },
        "requests_per_period": { "type": "integer", "minimum": 1 },
        "period": { "type": "integer" },
        "mitigation_timeout": { "type": "integer" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "expression", "skip"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string" },
        "reason": { "type": "string", "minLength": 10 },
        "expression": { "type": "string" },
        "skip": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    }
  }
}
