# Maktaba unified server configuration.
#
# `maktaba-server setup` generates this file for you interactively; this
# example documents every field. Resolved location:
#   Linux/macOS : $XDG_CONFIG_HOME/maktaba/server.toml (default
#                 ~/.config/maktaba/server.toml)
#   Windows     : %APPDATA%\Maktaba\server.toml
# Override with the MAKTABA_CONFIG environment variable.

[server]
# Ports: `setup` (the wizard, --node, --self-managed) and `serve` check that
# listen, web_listen and stream_addr are free. One that another program holds
# (Splunk takes 8088 and some backup tools 8080 on Windows desktops) moves to the
# first free port of 8780-8790 (web tries 8780 first, streaming 8781, the API
# 8782) and the new address is written back here and logged. A Windows full
# node (setup --node) prefers 8780 for the web UI. `serve --role X` never moves
# a port: a taken one stops it with the reason.
#
# Public API bind address.
listen = "0.0.0.0:8080"
# Writable state root: SQLite database, downloaded models, caches.
data_dir = "/var/lib/maktaba"
# Embedded web UI bind (the unified binary serves the SPA here and
# reverse-proxies /api to the API service for a single-origin app).
web_listen = "0.0.0.0:8088"
# API admin/metrics bind (health, /metrics).
admin_addr = ":9100"
# Streaming service public bind.
stream_addr = ":8081"

[database]
# SQLite (default, great for libraries under ~5 TB):
url = "sqlite:///var/lib/maktaba/maktaba.db"
# Postgres (recommended for large/multi-user libraries over ~5 TB):
# url = "postgres://maktaba:maktaba@localhost:5432/maktaba?sslmode=disable"

[media]
# One or more library roots scanned for media.
roots = ["/mnt/videos", "/mnt/movies"]

[transcription]
# Whisper backend: "mlx-whisper" (Apple Silicon), "faster-whisper"
# (CUDA/CPU), or "openai".
backend = "mlx-whisper"
model = "large-v3"

[cloud]
# Optional cloud-link enrolment.
enabled = false
# claim_code = "ABCD1234"

[supervisor]
# How `serve` keeps its child processes (api, streaming, pipeline) running.
# Every key is optional; these are the defaults.
# "always" restarts a child whenever it exits; "on-failure" leaves a clean
# exit (code 0) stopped; "never" stops the whole stack when any child exits
# (use it when systemd, launchd or compose restarts the service instead).
# restart = "always"
# Restart delay: starts at backoff_initial and doubles up to backoff_max;
# a child that stays up for healthy_after starts again from backoff_initial.
# backoff_initial = "1s"
# backoff_max = "60s"
# healthy_after = "5m"
# max_restarts exits inside max_restarts_window mark a child failed (a
# crash loop). The others keep running; it is retried every failed_retry.
# max_restarts = 5
# max_restarts_window = "10m"
# failed_retry = "5m"
# Liveness probes catch a hung child: probe_failures failed /healthz
# checks in a row (every probe_interval, each timing out after
# probe_timeout) kill and restart it. Failures only count after
# startup_grace, unless a probe has already answered.
# probe_interval = "10s"
# probe_timeout = "3s"
# probe_failures = 3
# startup_grace = "60s"
# Loopback address of the supervisor state endpoint (GET /processes). The
# API shows it at /api/system/processes. "off" disables it.
# admin_addr = "127.0.0.1:9103"
