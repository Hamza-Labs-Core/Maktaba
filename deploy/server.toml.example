# Maktaba unified server configuration.
#
# `maktaba-server setup` generates this file for you interactively; this
# example documents every field. Resolved location:
#   macOS   : ~/Library/Application Support/Maktaba/server.toml (keys in keys/,
#             data in data/, models, chroma and caches beside data/; logs in
#             ~/Library/Logs/Maktaba). An install from before (in ~/.config/maktaba
#             and ~/.local/share/maktaba) moves there once, on the next command.
#   Linux   : $XDG_CONFIG_HOME/maktaba/server.toml (default
#             ~/.config/maktaba/server.toml)
#   Windows : %LOCALAPPDATA%\Maktaba\server.toml (keys in keys\, data in data\,
#             models, chroma and caches beside data\; logs in logs\). An install
#             from before (in %APPDATA%\Maktaba) moves there once, on the next
#             command, unless it runs inside the Windows app (whose setup moves
#             an earlier install in instead).
# Override with the MAKTABA_CONFIG environment variable.

[server]
# Ports: `setup` (the wizard, --node, --self-managed) and `serve` check that
# listen, web_listen and stream_addr are free. One that another program holds
# (Splunk takes 8088 and some backup tools 8080 on Windows desktops) moves to the
# first free port of 8780-8790 (web tries 8780 first, streaming 8781, the API
# 8782) and the new address is written back here and logged. A Windows full
# node (setup --node) prefers 8780 for the web UI. `serve --role X` never moves
# a port: a taken one stops it with the reason.
#
# Public API bind address.
listen = "0.0.0.0:8080"
# Writable state root: SQLite database, downloaded models, caches.
data_dir = "/var/lib/maktaba"
# Embedded web UI bind (the unified binary serves the SPA here and
# reverse-proxies /api to the API service for a single-origin app).
web_listen = "0.0.0.0:8088"
# API admin/metrics bind (health, /metrics).
admin_addr = ":9100"
# Streaming service public bind.
stream_addr = ":8081"

[database]
# SQLite (default, great for libraries under ~5 TB):
url = "sqlite:///var/lib/maktaba/maktaba.db"
# Postgres (recommended for large/multi-user libraries over ~5 TB):
# url = "postgres://maktaba:maktaba@localhost:5432/maktaba?sslmode=disable"
# Maktaba.app (Epic 36): leave url out and the Postgres bundled with the app is
# used ([postgres] below), so Live TV's slots stay on.

[postgres]
# The Postgres bundled with Maktaba.app, run by `serve` as its first process
# (started before the others, stopped after them): a cluster private to this
# install in <state>/postgres (on a Mac ~/Library/Application Support/Maktaba/
# postgres), loopback only plus a unix socket in that directory, scram-sha-256
# passwords in keys/ (postgres-maktaba_admin.password, postgres-maktaba.password),
# a nightly pg_dump into backups/ (the newest 7 kept).
# On Windows the app's Postgres is TCP-only (no unix socket), and postgres.exe
# runs under a restricted token when the server runs as an administrator (it
# refuses administrative rights, as pg_ctl does).
# "auto" (default): on a Mac whose app carries Postgres, and inside the Windows
# app's payload, unless [database] url is set or a SQLite database is already in
# use. "on" / "off".
# enabled = "auto"
# The Postgres install (bin/postgres, bin/initdb, bin/psql, bin/pg_dump);
# default $MAKTABA_POSTGRES_HOME, else the app's Resources/server/postgres.
# home = ""
# port = 54329

[media]
# One or more library roots scanned for media.
roots = ["/mnt/videos", "/mnt/movies"]
# The share's paths on this machine, in the workers' --path-map form
# ("<stored prefix>=<local prefix>", comma separated): MAKTABA_PATH_MAP for
# every role, MAKTABA_WORKER_PATH_MAP for the pipeline.
# path_map = "/Volumes/Originals/=/Users/me/nas-nfs/"

[transcription]
# The Whisper model (a Hugging Face repo or a folder): MAKTABA_STT_MODEL. Empty,
# or an old short name such as "large-v3": the pipeline's default, turbo in the
# engine's format: mlx-community/whisper-large-v3-turbo on Apple Silicon (MLX),
# dropbox-dash/faster-whisper-large-v3-turbo on Windows and Linux (CTranslate2;
# an MLX model given there is replaced by its CTranslate2 conversion).
# model = "mlx-community/whisper-large-v3-turbo"
# The second listen that corrects Whisper's words: "on" (default) / "off"
# (MAKTABA_STT_REFINE), and its model (MAKTABA_STT_REFINE_MODEL; a repo or a
# local folder, default CohereLabs/cohere-transcribe-arabic-07-2026).
# refine = "on"
# refine_model = "CohereLabs/cohere-transcribe-arabic-07-2026"
# Transcription workers beside the main worker (each one batched Whisper; the
# main worker then skips transcribe). 0 (default): sized from the RAM on Apple
# Silicon (96 GB and up: 2 workers, 16 h of audio, 20 GB GPU, 2 GB cache, back
# off below 25% free, as the home Mac runs; smaller Macs less), from the GPU's
# memory on Windows and Linux with an NVIDIA GPU of 4 GB or more (8 GB: one
# worker), none on a machine that transcribes on the CPU (the main worker does).
# -1: none. [pipeline] instances, when set, wins. With refine on, a Windows or
# Linux machine (no second listen there yet) plans none, and its main worker
# transcribes only when Settings, Transcription, "Transcribe without the second
# listen" is on. More workers than planned share its GPU memory, CPU threads and
# audio hours. None at all while your own MAKTABA_PIPELINE_EXCLUDE_STAGES names
# transcribe.
# workers = 0
# Per worker, 0 = sized from the RAM: MAKTABA_STT_AUDIO_HOURS, _MIN_FREE_PCT,
# and on Apple Silicon MLX's GPU memory, _GPU_GB and _GPU_CACHE_GB (an
# environment variable of your own wins).
# audio_hours = 0
# gpu_gb = 0
# gpu_cache_gb = 0
# min_free_pct = 0
# Files a worker decodes together, one 30 s window of each per pass
# (MAKTABA_STT_BATCH). 0: sized from the GPU's memory (8 GB: 8), 4 on the CPU,
# 32 on Apple Silicon.
# batch = 0
# Windows and Linux (CTranslate2) only. Where: "auto" (the NVIDIA GPU when CUDA
# works there, else the CPU), "cuda", "cuda:1" or "cpu" (MAKTABA_STT_DEVICE).
# Precision: "auto" (float16 on the GPU, int8_float16 on one under 7 GB, int8 on
# the CPU) or float16, int8_float16, int8, int8_float32, float32
# (MAKTABA_STT_COMPUTE_TYPE). Threads on the CPU, 0: half the logical CPUs
# (MAKTABA_STT_CPU_THREADS).
# device = "auto"
# compute_type = "auto"
# cpu_threads = 0
# Kept for older files: the pipeline picks MLX or CTranslate2 by itself.
backend = "mlx-whisper"

[cloud]
# Optional cloud-link enrolment.
enabled = false
# claim_code = "ABCD1234"

[supervisor]
# How `serve` keeps its child processes (api, streaming, pipeline) running.
# Every key is optional; these are the defaults.
# "always" restarts a child whenever it exits; "on-failure" leaves a clean
# exit (code 0) stopped; "never" stops the whole stack when any child exits
# (use it when systemd, launchd or compose restarts the service instead).
# restart = "always"
# Restart delay: starts at backoff_initial and doubles up to backoff_max;
# a child that stays up for healthy_after starts again from backoff_initial.
# backoff_initial = "1s"
# backoff_max = "60s"
# healthy_after = "5m"
# max_restarts exits inside max_restarts_window mark a child failed (a
# crash loop). The others keep running; it is retried every failed_retry.
# max_restarts = 5
# max_restarts_window = "10m"
# failed_retry = "5m"
# Liveness probes catch a hung child: probe_failures failed /healthz
# checks in a row (every probe_interval, each timing out after
# probe_timeout) kill and restart it. Failures only count after
# startup_grace, unless a probe has already answered.
# probe_interval = "10s"
# probe_timeout = "3s"
# probe_failures = 3
# startup_grace = "60s"
# Loopback address of the supervisor state endpoint (GET /processes). The
# API shows it at /api/system/processes. "off" disables it.
# admin_addr = "127.0.0.1:9103"
