#!/bin/sh
# Runs one Maktaba node worker for launchd (com.maktaba.node*.plist, Epic 31).
#
#   maktaba-node-run [main|<instance>]
#
# The plist passes the install, config and log directories in MAKTABA_NODE_DIR,
# MAKTABA_NODE_CONF_DIR and MAKTABA_NODE_LOG_DIR. Before every start this:
#   1. reads node.env, then node@<instance>.env, from the config directory (KEY=VALUE
#      lines, no shell expansion: the same files and format systemd's EnvironmentFile=
#      and the Windows runner read), so a settings change needs only a restart;
#   2. rotates the instance's log files past MAKTABA_NODE_LOG_MAX_MB (default 50; three
#      old files kept) and reopens stdout / stderr on them (launchd itself never rotates);
#   3. runs `maktaba-pipeline run --node`, passing launchd's SIGTERM on to it, and turns
#      its exit status into what launchd's KeepAlive (SuccessfulExit = false) should do:
#        0   stopped                                  -> 0, stays stopped
#        77  the home removed this machine for good   -> 0, stays stopped (logged)
#        78  not joined to a home yet                 -> 78, tried again in 30 s
#        any other failure (home unreachable, crash)  -> as is, tried again in 30 s
set -u

instance="${1:-main}"
node_dir="${MAKTABA_NODE_DIR:?MAKTABA_NODE_DIR is not set (start this from launchd)}"
conf_dir="${MAKTABA_NODE_CONF_DIR:?MAKTABA_NODE_CONF_DIR is not set}"
log_dir="${MAKTABA_NODE_LOG_DIR:?MAKTABA_NODE_LOG_DIR is not set}"
# the venv's maktaba-pipeline (install-node.sh links it here)
cli="$node_dir/bin/maktaba-pipeline"

if [ "$instance" = main ]; then
    base=node
else
    base="node@$instance"
fi

load_env() {
    [ -f "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'*) continue ;;
            'export '*) line=${line#export } ;;
        esac
        case "$line" in *=*) ;; *) continue ;; esac
        key=${line%%=*}
        value=${line#*=}
        case "$key" in
            '' | [0-9]* | *[!A-Za-z0-9_]*) continue ;;
        esac
        case "$value" in
            \"*\") value=${value#\"}; value=${value%\"} ;;
            \'*\') value=${value#\'}; value=${value%\'} ;;
        esac
        export "$key=$value"
    done <"$1"
}

rotate() {
    file=$1
    [ -f "$file" ] || return 0
    size=$(wc -c <"$file" 2>/dev/null | tr -d ' ')
    [ "${size:-0}" -gt "$max_bytes" ] || return 0
    rm -f "$file.3"
    if [ -f "$file.2" ]; then mv -f "$file.2" "$file.3"; fi
    if [ -f "$file.1" ]; then mv -f "$file.1" "$file.2"; fi
    mv -f "$file" "$file.1"
}

say() {
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) [maktaba-node-run $instance] $*" >&2
}

load_env "$conf_dir/node.env"
if [ "$instance" != main ]; then
    load_env "$conf_dir/node@$instance.env"
fi
# A node takes its database from its node config; a MAKTABA_DATABASE_URL would make the
# worker run as a home worker against that database instead.
unset MAKTABA_DATABASE_URL

max_mb="${MAKTABA_NODE_LOG_MAX_MB:-50}"
case "$max_mb" in '' | *[!0-9]*) max_mb=50 ;; esac
max_bytes=$((max_mb * 1024 * 1024))

mkdir -p "$log_dir"
out="$log_dir/$base.log"
err="$log_dir/$base.err.log"
rotate "$out"
rotate "$err"
exec >>"$out" 2>>"$err"

if [ ! -x "$cli" ]; then
    say "no $cli; run deploy/packaging/node/install-node.sh again"
    exit 78
fi

# Not exec: this shell stays to read the exit status, so it hands launchd's stop
# signal on to the worker.
"$cli" run --node &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM
trap 'kill -INT "$child" 2>/dev/null' INT
trap 'kill -HUP "$child" 2>/dev/null' HUP

status=0
wait "$child" || status=$?
# A trapped signal interrupts wait while the worker winds down: wait again for its status.
while kill -0 "$child" 2>/dev/null; do
    status=0
    wait "$child" || status=$?
done

case "$status" in
    77)
        say "the home removed this machine (revoked, not a member, or its database login refused): not starting it again. Join again (maktaba-pipeline join) or uninstall (uninstall-node.sh)."
        exit 0
        ;;
    78)
        say "this machine has not joined a home yet (exit 78): launchd tries again in 30 s; run: maktaba-pipeline join"
        ;;
    0) ;;
    *)
        say "the worker exited with status $status: launchd starts it again in 30 s"
        ;;
esac
exit "$status"
