# Maktaba node worker (Epic 31) — systemd USER unit: the main worker of a machine
# that joined a Maktaba home. Installed by deploy/packaging/node/install-node.sh to
# ~/.config/systemd/user/; extra transcription workers are maktaba-node@<N>.service.
#
# A user unit runs as you, with your share mounts and your node config
# (~/.config/maktaba/node.json). With lingering on (`loginctl enable-linger`, which the
# installer turns on) it starts at boot, before anyone logs in.
#
# Ordering: a user manager cannot see the system's network-online.target or
# remote-fs.target, so this unit cannot wait for them (the system variant in
# ../system/ does). A worker started before the network or the share is up fails its
# first database connect and is restarted below until it gets through.
[Unit]
Description=Maktaba node worker
Documentation=https://github.com/Hamza-Labs-Core/Maktaba/blob/main/deploy/packaging/node/README.md
# Keep retrying for as long as the home is unreachable (no start-rate limit).
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h
Environment=MAKTABA_ENV=prod
Environment=PYTHONUNBUFFERED=1
# Optional settings (KEY=VALUE); they win over the lines above. (%h/.config rather than
# %E, which needs systemd 240+.)
EnvironmentFile=-%h/.config/maktaba/node.env
# A node takes its database from the node config; MAKTABA_DATABASE_URL would turn the
# worker into a home worker on that database.
UnsetEnvironment=MAKTABA_DATABASE_URL
# `run --node`: work as this machine's node, or exit 78 when it has not joined a home
# (never fall back to another database). bin/maktaba-pipeline is the venv's own
# command (a stand-in only for a pipeline without that entry point).
ExecStart=%h/.local/share/maktaba/node/bin/maktaba-pipeline run --node
# Crash, home unreachable, not joined yet (78): start again after 30 s, for as long as it
# takes, so the worker also starts by itself once `maktaba-pipeline join` completes.
# A clean exit (stopped) is final, and so is 77: the home removed this machine (revoked,
# not a member, database login refused), which no restart can fix.
Restart=on-failure
RestartSec=30
RestartPreventExitStatus=77
# SIGTERM to the worker first so it hands its jobs back; SIGKILL to what is left.
KillMode=mixed
TimeoutStopSec=60
SyslogIdentifier=maktaba-node
NoNewPrivileges=true

[Install]
WantedBy=default.target
