# Maktaba node worker (Epic 31) — systemd SYSTEM unit: the main worker of a headless
# machine that joined a Maktaba home. Installed by
# `sudo deploy/packaging/node/install-node.sh --system [--run-as USER]` to
# /etc/systemd/system/; extra transcription workers are maktaba-node@<N>.service.
#
# Use this variant when the share is mounted system-wide (/etc/fstab, autofs) and the
# worker should start at boot with no user session. It runs as User= below (the
# installer's drop-in maktaba-node.service.d/10-run-as.conf names the account); that
# account must be able to read and write the share, and its node config is
# ~<user>/.config/maktaba/node.json (join as that user: the installer does).
[Unit]
Description=Maktaba node worker
Documentation=https://github.com/Hamza-Labs-Core/Maktaba/blob/main/deploy/packaging/node/README.md
After=network-online.target remote-fs.target
Wants=network-online.target
# Keep retrying for as long as the home is unreachable (no start-rate limit).
StartLimitIntervalSec=0

[Service]
Type=simple
User=maktaba
Group=maktaba
WorkingDirectory=~
Environment=MAKTABA_ENV=prod
Environment=PYTHONUNBUFFERED=1
# Optional settings (KEY=VALUE); they win over the lines above.
EnvironmentFile=-/etc/maktaba/node.env
# A node takes its database from the node config; MAKTABA_DATABASE_URL would turn the
# worker into a home worker on that database.
UnsetEnvironment=MAKTABA_DATABASE_URL
# Refuse to start (exit 78) until the machine has joined: `run` without a joined config
# would fall back to an in-memory database. Restart= retries, so the worker starts by
# itself once `maktaba-pipeline join` completes.
ExecStartPre=/opt/maktaba/node/venv/bin/python /opt/maktaba/node/node_check.py
ExecStart=/opt/maktaba/node/venv/bin/python -m maktaba_pipeline run
# Crash, failed start, home unreachable: restart. A clean exit (stopped, or revoked on
# the home) is final.
Restart=on-failure
RestartSec=30
# SIGTERM to the worker first so it hands its jobs back; SIGKILL to what is left.
KillMode=mixed
TimeoutStopSec=60
SyslogIdentifier=maktaba-node

# Hardening. Not ProtectHome= (the node config and the model / audio caches live in the
# account's home) and not PrivateDevices= (GPU stages need /dev/nvidia*). The share is
# written to (subtitles beside the media), so the filesystem is not made read-only
# beyond /usr, /boot and /etc.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
