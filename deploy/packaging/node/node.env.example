# Maktaba node worker settings (optional). Every line is KEY=VALUE; # starts a comment.
# No shell expansion: write values out in full (no $HOME, no ~).
#
# The installers copy this file to the node's config directory the first time, as
#   macOS    ~/Library/Application Support/Maktaba/node.env
#   Linux    ~/.config/maktaba/node.env        (system units: /etc/maktaba/node.env)
#   Windows  %APPDATA%\Maktaba\node.env
# and read it at every start of every worker on the machine. A file named
# node@<instance>.env beside it applies to one instance only (for example node@2.env)
# and wins over this one. Restart the workers after editing (see README.md).

# --- Tools -----------------------------------------------------------------------
# Full paths when ffmpeg / ffprobe are not on the service's PATH (the installers fill
# these in when they find ffmpeg somewhere the service would not look).
#MAKTABA_FFMPEG=/opt/homebrew/bin/ffmpeg
#MAKTABA_FFPROBE=/opt/homebrew/bin/ffprobe

# --- Shared storage ----------------------------------------------------------------
# Extra places to look for the share when working out the path map
# (separated by : on macOS / Linux, by ; on Windows).
#MAKTABA_STORAGE_HINTS=/mnt/nas
# A fixed path map instead of the inferred / admin-set one ('db_prefix=local_prefix;...').
#MAKTABA_WORKER_PATH_MAP=Y:/=/Volumes/Y

# --- What this worker runs ----------------------------------------------------------
# Comma-separated stage lists (the home's switches still apply on top).
# The installers set these for the extra transcription workers (see --instances).
#MAKTABA_PIPELINE_STAGES=
#MAKTABA_PIPELINE_EXCLUDE_STAGES=

# --- Node identity -----------------------------------------------------------------
# Another node config file (two separate nodes on one host; mostly for tests).
#MAKTABA_NODE_CONFIG=/path/to/node.json

# --- Cluster channel (Epic 31 phase 2, design-agent.md) ----------------------------
# Where this machine writes its logs / metrics / LLM usage files. Default: the share's
# maktaba/cluster folder, else ~/.maktaba/cluster.
#MAKTABA_SHARE_ROOT=
#MAKTABA_CLUSTER_DIR=
#MAKTABA_CLUSTER_RETENTION_DAYS=14
#MAKTABA_CLUSTER_FILE_MB=256

# --- Local LLM runtimes this machine offers the cluster ------------------------------
#MAKTABA_OLLAMA_URL=http://127.0.0.1:11434
# OpenAI-compatible servers (LM Studio, vLLM, llama.cpp), comma-separated base URLs.
#MAKTABA_LLM_ENDPOINTS=http://127.0.0.1:1234/v1
#MAKTABA_LLM_MAX_PARALLEL=1

# --- Logs ---------------------------------------------------------------------------
# dev = human-readable lines instead of JSON.
#MAKTABA_ENV=prod
# macOS / Windows: rotate a worker's log file past this size when the worker starts.
#MAKTABA_NODE_LOG_MAX_MB=50
