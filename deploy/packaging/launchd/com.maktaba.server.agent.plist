<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.maktaba.server</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/Maktaba/server/maktaba-launcher</string>
    <string>--root</string>
    <string>__HOME__/Library/Application Support/Maktaba/server</string>
    <string>serve</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>AbandonProcessGroup</key>
  <true/>

  <key>ExitTimeOut</key>
  <integer>90</integer>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/Maktaba/server.log</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/Maktaba/server.err.log</string>

  <key>WorkingDirectory</key>
  <string>__HOME__/Library/Application Support/Maktaba/server</string>
</dict>
</plist>
