[Unit]
Description=Maktaba (launcher: current release of maktaba-server)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maktaba
Group=maktaba
Environment=MAKTABA_CONFIG=/etc/maktaba/server.toml
ExecStart=/usr/bin/maktaba-launcher --root /var/lib/maktaba serve
Restart=always
RestartSec=5
RestartForceExitStatus=75
KillMode=mixed
TimeoutStopSec=90
LimitNOFILE=65536

# Hardening (Story 23). Only the install root and the log directory are
# writable (ProtectSystem=strict): releases live under the root, never /usr.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/maktaba /var/log/maktaba

[Install]
WantedBy=multi-user.target
