# Third-party pieces of the Maktaba.app server payload (Epic 36, story 36.7), macOS arm64.
# Every download is checked against the SHA-256 here before it is used; bumping a piece
# is a reviewed change to this file. Sourced by payload.sh (KEY=VALUE only).
# Sources, licences and why each was chosen: README.md in this directory.

# PostgreSQL 16 (the repo's major: compose, CI). theseus-rs/postgresql-binaries: relocatable
# (@loader_path) builds with OpenSSL, the contrib extensions Maktaba uses (pg_trgm, pgcrypto,
# unaccent), pg_dump/pg_restore/psql. Needs macOS 15+.
POSTGRES_VERSION=16.15.0
POSTGRES_URL=https://github.com/theseus-rs/postgresql-binaries/releases/download/16.15.0/postgresql-16.15.0-aarch64-apple-darwin.tar.gz
POSTGRES_SHA256=46f6382024d9b633d1f4b4903ffef8c2404e00ae83098d628c00591048cb0512

# ffmpeg / ffprobe 8.1.2, static (system frameworks only), from ffmpeg.martin-riedl.de.
# 8.1 is what the home Mac runs today. GPLv3 build (--enable-gpl --enable-version3).
FFMPEG_VERSION=8.1.2
FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffmpeg.zip
FFMPEG_SHA256=ef1aa60006c7b77ce170c1608c08d8e4ba1c30c5746f2ac986ded932d0ac2c3c
FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffprobe.zip
FFPROBE_SHA256=c39787f4af7a3932502d2d48db6f6feaaa836b48a73ef78c32cc3285df61dfaf

# CPython 3.12 (pipeline/.python-version), astral-sh/python-build-standalone, install_only_stripped.
PYTHON_VERSION=3.12.15
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-aarch64-apple-darwin-install_only_stripped.tar.gz
PYTHON_SHA256=ad8d0c637c0a36b967b310e2c07254f4d2ca8cabaa7699e55ed6290aceb481a2
