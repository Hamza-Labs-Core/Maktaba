# Third-party pieces of the Maktaba.app server payload (Epic 36, story 36.7), macOS arm64.
# Every download is checked against the SHA-256 here before it is used; bumping a piece
# is a reviewed change to this file. Sourced by payload.sh (KEY=VALUE only).
# Sources, licences and why each was chosen: README.md in this directory.

# PostgreSQL 16 (the repo's major: compose, CI). theseus-rs/postgresql-binaries: relocatable
# (@loader_path) builds with OpenSSL, the contrib extensions Maktaba uses (pg_trgm, pgcrypto,
# unaccent), pg_dump/pg_restore/psql. Needs macOS 15+.
POSTGRES_VERSION=16.15.0
POSTGRES_URL=https://github.com/theseus-rs/postgresql-binaries/releases/download/16.15.0/postgresql-16.15.0-aarch64-apple-darwin.tar.gz
POSTGRES_SHA256=46f6382024d9b633d1f4b4903ffef8c2404e00ae83098d628c00591048cb0512

# pgvector 0.8.7 (semantic search in Postgres, specs/epics/43-pgvector-search), the source
# tag: payload.sh builds it against the PostgreSQL above (pgxs, no -march=native, so it runs
# on every Apple silicon Mac) into postgres/lib and postgres/share/extension. PostgreSQL
# License.
PGVECTOR_VERSION=0.8.7
PGVECTOR_URL=https://github.com/pgvector/pgvector/archive/refs/tags/v0.8.7.tar.gz
PGVECTOR_SHA256=cac0b10c360f05b2d521200105ba3697e773d4cd3731f5a915a7e37ebe0bea85

# PostgreSQL 18 (Epic 49, story 49.1): the next major, in postgres-18/ beside PostgreSQL 16
# until the updater's upgrade (story 49.2) moves the database onto it; the same theseus-rs
# builds as 16 (they also carry LLVM and PL/Python, which payload.sh leaves out).
POSTGRES18_VERSION=18.7.0
POSTGRES18_URL=https://github.com/theseus-rs/postgresql-binaries/releases/download/18.7.0/postgresql-18.7.0-aarch64-apple-darwin.tar.gz
POSTGRES18_SHA256=86456c0ed99d2466524eaa074db6580cf7d748b91042e252c83eaca9a9d216e7

# pg_textsearch 1.5.1 (Timescale; BM25 ranked keyword search, Epic 49), the source tag:
# payload.sh builds it against PostgreSQL 18 (pgxs, with_llvm=no) into postgres-18/lib and
# postgres-18/share/extension. It needs shared_preload_libraries, which the bundled server
# sets when its lib/ has it (pgbundle). PostgreSQL License.
PGTEXTSEARCH_VERSION=1.5.1
PGTEXTSEARCH_URL=https://github.com/timescale/pg_textsearch/archive/refs/tags/v1.5.1.tar.gz
PGTEXTSEARCH_SHA256=2e7fb76ed96176afc6d16cc5d095ced2cb233ff27fbeaa8c7bfffc82e02f7498

# ffmpeg / ffprobe 8.1.2, static (system frameworks only), from ffmpeg.martin-riedl.de.
# 8.1 is what the home Mac runs today. GPLv3 build (--enable-gpl --enable-version3).
FFMPEG_VERSION=8.1.2
FFMPEG_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffmpeg.zip
FFMPEG_SHA256=ef1aa60006c7b77ce170c1608c08d8e4ba1c30c5746f2ac986ded932d0ac2c3c
FFPROBE_URL=https://ffmpeg.martin-riedl.de/download/macos/arm64/1783011502_8.1.2/ffprobe.zip
FFPROBE_SHA256=c39787f4af7a3932502d2d48db6f6feaaa836b48a73ef78c32cc3285df61dfaf

# CPython 3.12 (pipeline/.python-version), astral-sh/python-build-standalone, install_only_stripped.
PYTHON_VERSION=3.12.15
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-aarch64-apple-darwin-install_only_stripped.tar.gz
PYTHON_SHA256=ad8d0c637c0a36b967b310e2c07254f4d2ca8cabaa7699e55ed6290aceb481a2

# Ollama 0.40.2, the language model server of the pipeline's LLM stages (check-tags,
# check-clips, enrich), ollama/ollama's macOS release tarball (universal; ollama and
# llama-server are thinned to arm64, the x86_64 CPU backends and the MLX engine are left
# out). SHA-256 from the release's sha256sum.txt. MIT.
OLLAMA_VERSION=0.40.2
OLLAMA_URL=https://github.com/ollama/ollama/releases/download/v0.40.2/ollama-darwin.tgz
OLLAMA_SHA256=e888b7637291ceb80b622c00ea067f62c86d9c50d419b3eb903032e4f1f8a4f6
