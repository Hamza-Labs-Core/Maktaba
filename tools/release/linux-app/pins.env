# Third-party pieces of the Linux server payload (Epic 39, story 39.2), x86_64 and aarch64.
# Every download is checked against the SHA-256 here before it is used; bumping a piece
# is a reviewed change to this file. Sourced by payload.sh (KEY=VALUE only); the _X86_64 /
# _AARCH64 suffix is the machine the payload is built for.
# Sources, licences and why each was chosen: README.md in this directory.

# PostgreSQL 16 (the repo's major: compose, CI), theseus-rs/postgresql-binaries: the build
# Maktaba.app bundles (mac-app/pins.env) and pgbin fetches for a node's copy (Epic 37), with
# the same SHA-256s. It links the system's OpenSSL 3, libxml2, lz4, zstd and krb5, which
# payload.sh copies in beside it; it needs glibc 2.34.
POSTGRES_VERSION=16.15.0
POSTGRES_URL_X86_64=https://github.com/theseus-rs/postgresql-binaries/releases/download/16.15.0/postgresql-16.15.0-x86_64-unknown-linux-gnu.tar.gz
POSTGRES_SHA256_X86_64=77dd669eda3985ea8be26256f6af28d3c8414152ada713797555bb7423b4486a
POSTGRES_URL_AARCH64=https://github.com/theseus-rs/postgresql-binaries/releases/download/16.15.0/postgresql-16.15.0-aarch64-unknown-linux-gnu.tar.gz
POSTGRES_SHA256_AARCH64=f6d49ffbaea28cf8732785b18afb75bded905667d4ec8e2308a13a30fe0a24d1

# ffmpeg / ffprobe 8.1.2 from ffmpeg.martin-riedl.de, the source of the Mac's: the same
# release and build scripts. GPLv3 build (--enable-gpl --enable-version3). Linked against
# glibc 2.35 and libstdc++ of GCC 12 only (the payload's baseline).
FFMPEG_VERSION=8.1.2
FFMPEG_URL_X86_64=https://ffmpeg.martin-riedl.de/download/linux/amd64/1783011670_8.1.2/ffmpeg.zip
FFMPEG_SHA256_X86_64=56452c0bfc4ee0325cd615d62f46ba8264f62eed34f727c2224c6c84fa7b8719
FFPROBE_URL_X86_64=https://ffmpeg.martin-riedl.de/download/linux/amd64/1783011670_8.1.2/ffprobe.zip
FFPROBE_SHA256_X86_64=c6f2d36e98f9a4445fad0b0be539f4c4faf13fd502116bf131becd53f56cd390
FFMPEG_URL_AARCH64=https://ffmpeg.martin-riedl.de/download/linux/arm64/1783010599_8.1.2/ffmpeg.zip
FFMPEG_SHA256_AARCH64=ab9e16864b6bf4ae7e13bbdbdc29621be11a5c547c57af8d4250e9fa2f5e6461
FFPROBE_URL_AARCH64=https://ffmpeg.martin-riedl.de/download/linux/arm64/1783010599_8.1.2/ffprobe.zip
FFPROBE_SHA256_AARCH64=fb78317b81cdeb614533be59e489019b754afd199670666af28f0e9574be395b

# CPython 3.12 (pipeline/.python-version), astral-sh/python-build-standalone,
# install_only_stripped: relocatable, glibc 2.17, OpenSSL built in. The Mac's release.
PYTHON_VERSION=3.12.15
PYTHON_URL_X86_64=https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_SHA256_X86_64=731af898886c5f821890dc901eca3c651cca8e51fa7308c159d12a1194aeac91
PYTHON_URL_AARCH64=https://github.com/astral-sh/python-build-standalone/releases/download/20261003/cpython-3.12.15%2B20261003-aarch64-unknown-linux-gnu-install_only_stripped.tar.gz
PYTHON_SHA256_AARCH64=6541297dd1798dec8b98c3ad7492808a5b9d1c126801ceb2011e7754cd20d1ce

# The newest glibc any file of the payload may need (check.sh fails above it): the
# ffmpeg builds' 2.35 (Ubuntu 22.04, Debian 12, Fedora 36, RHEL 10).
MAX_GLIBC=2.35
