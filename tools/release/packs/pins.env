# What the file-gathering pack recipes download (story 51.15), each pinned by sha256: a
# recipe checks every file before it puts it in a pack (fetch.sh), so the same commit packs
# the same bytes.

# model.refine: CAMeL Tools' Modern Standard Arabic morphology database, the package
# morphology-db-msa-r13 of camel-tools 1.6's data catalogue (the second listen's spelling,
# models/fetch_cli.py), with that catalogue pinned at a commit of CAMeL-Lab/camel-tools-data.
# GPL v2. The two files' digests are the catalogue's own.
CAMEL_PACKAGE=morphology-db-msa-r13
CAMEL_PACKAGE_VERSION=0.4.0
CAMEL_DESTINATION=morphology_db/calima-msa-r13
CAMEL_DB_URL=https://github.com/CAMeL-Lab/camel-tools-data/releases/download/2022.03.21/morphology_db_calima-msa-r13-0.4.0.zip
CAMEL_DB_SHA256=fe6531250c5529307627cc63ed56447cbb9968020d6ea3ab867e6ad9af94c738
CAMEL_DB_LICENSE_SHA256=7a71f85f07e46759dcc1c16dba64352d9932447759cf71ca3deae3729d85d23e
CAMEL_DB_FILE_SHA256=195bc25a333237a2126470da888d7936b59ed3729f9210e0a4194ba43497dd70
CAMEL_CATALOGUE_URL=https://raw.githubusercontent.com/CAMeL-Lab/camel-tools-data/9b1965c681735a22b92adc313bf9a3b093c676a3/catalogue-1.6.json
CAMEL_CATALOGUE_SHA256=bde5abed1f15cdf52ad804affdea53bc06d1bfdb4d8e77d3d6a8159b2a2ef6d1

# tool.ffmpeg: ffmpeg / ffprobe 8.1.2, static, from ffmpeg.martin-riedl.de: the version and
# builder the Mac app carries (tools/release/mac-app/pins.env), for a Linux machine whose
# distribution's ffmpeg is missing or too old. GPLv3 build (--enable-gpl --enable-version3).
FFMPEG_VERSION=8.1.2
FFMPEG_LINUX_AMD64_URL=https://ffmpeg.martin-riedl.de/download/linux/amd64/1783011670_8.1.2/ffmpeg.zip
FFMPEG_LINUX_AMD64_SHA256=56452c0bfc4ee0325cd615d62f46ba8264f62eed34f727c2224c6c84fa7b8719
FFPROBE_LINUX_AMD64_URL=https://ffmpeg.martin-riedl.de/download/linux/amd64/1783011670_8.1.2/ffprobe.zip
FFPROBE_LINUX_AMD64_SHA256=c6f2d36e98f9a4445fad0b0be539f4c4faf13fd502116bf131becd53f56cd390
FFMPEG_LINUX_ARM64_URL=https://ffmpeg.martin-riedl.de/download/linux/arm64/1783010599_8.1.2/ffmpeg.zip
FFMPEG_LINUX_ARM64_SHA256=ab9e16864b6bf4ae7e13bbdbdc29621be11a5c547c57af8d4250e9fa2f5e6461
FFPROBE_LINUX_ARM64_URL=https://ffmpeg.martin-riedl.de/download/linux/arm64/1783010599_8.1.2/ffprobe.zip
