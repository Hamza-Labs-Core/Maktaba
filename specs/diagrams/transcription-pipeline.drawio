        </mxCell>
        <mxCell id="te7" value="no — fresh" style="endArrow=classic;html=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="resume_check" target="audio_swim">
