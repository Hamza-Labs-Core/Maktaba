        </mxCell>
        <mxCell id="te17" value="pause" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stt_loop_swim" source="stt_check_pause" target="stt_paused">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te18" value="cancel" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stt_loop_swim" source="stt_check_pause" target="stt_cancelled">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te19" value="continue" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stt_loop_swim" source="stt_check_pause" target="stt_continue">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te20" value="loop back" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="stt_loop_swim" source="stt_continue" target="stt_yield">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te21" value="EOF" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stt_loop_swim" source="stt_yield" target="stt_done">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DB writes from STT loop -->
        <mxCell id="te22" value="atomic commit per segment" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="stt_commit" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- DONE → subtitle_gen + index -->
        <mxCell id="te23" value="enqueue subtitle_gen + index" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="stt_done" target="subgen_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te24" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="1" source="stt_done" target="index_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subgen internal -->
        <mxCell id="te25" style="endArrow=classic;html=1;" edge="1" parent="subgen_swim" source="subgen_input" target="subgen_split">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te26" style="endArrow=classic;html=1;" edge="1" parent="subgen_swim" source="subgen_split" target="subgen_speaker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te27" style="endArrow=classic;html=1;" edge="1" parent="subgen_swim" source="subgen_speaker" target="subgen_write">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te28" style="endArrow=classic;html=1;" edge="1" parent="subgen_swim" source="subgen_write" target="subgen_row">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Index internal -->
        <mxCell id="te29" style="endArrow=classic;html=1;" edge="1" parent="index_swim" source="index_chunk" target="index_fts">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te30" style="endArrow=classic;html=1;" edge="1" parent="index_swim" source="index_chunk" target="index_embed">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te31" style="endArrow=classic;html=1;" edge="1" parent="index_swim" source="index_embed" target="index_chroma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te32" style="endArrow=classic;html=1;" edge="1" parent="index_swim" source="index_chroma" target="index_advance">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te33" value="on failure" style="endArrow=classic;html=1;fontSize=10;dashed=1;" edge="1" parent="index_swim" source="index_chroma" target="index_dlq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te34" style="endArrow=classic;html=1;" edge="1" parent="index_swim" source="index_advance" target="index_publish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subgen DB writes -->
        <mxCell id="te35" value="writes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="subgen_row" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="te36" value="writes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="index_advance" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Reaper / heartbeat -->
        <mxCell id="reaper" value="Reaper (30 s tick)&#10;state ∈ {claimed,running,resuming}&#10;AND last_heartbeat_at &lt; now() − 90 s&#10;→ flip to PAUSED · paused_reason='crash'&#10;paused_at_sec = last_segment_end_sec" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1740" y="320" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="te37" value="reads · writes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="reaper" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend_text" value="Why this works on crash: every audio second written to transcript_segments has its end_sec mirrored in processing_jobs.last_segment_end_sec (one transaction). Recovery = resume = a normal claim from PAUSED. No JSON sidecar checkpoint. Worst case lost work on crash = the in-flight ≤30 s segment that wasn't yet committed." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="1340" width="2280" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
