        </mxCell>

        <!-- Threat actor / replay annotations -->
        <mxCell id="leakWarn" value="If a signed URL leaks: lib=[res_lib] only — does not expose other library memberships.&#10;exp limits replay window. jti can be added to a deny-list (Streaming + audit_log) on suspicion." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE4E6;strokeColor=#9F1239;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=4;dashed=1" vertex="1" parent="1">
          <mxGeometry x="40" y="1130" width="1900" height="50" as="geometry" />
        </mxCell>

        <!-- Boundary labels -->
        <mxCell id="bound1" value="🚧 TRUST BOUNDARY · TLS terminator" style="text;html=1;align=center;fontSize=11;fontColor=#B45309;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="1920" height="14" as="geometry" />
        </mxCell>
        <mxCell id="bound2" value="🚧 TRUST BOUNDARY · Caddy → backend (HTTP/2 cleartext or mTLS, internal-only)" style="text;html=1;align=center;fontSize=11;fontColor=#166534;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="445" width="1920" height="14" as="geometry" />
        </mxCell>

        <mxCell id="footerSec" value="Single-user mode: env-configured admin bootstrap token bypasses users + JWT — disabled when MAKTABA_AUTH_MODE=multi-user.&#10;Native clients (mobile/desktop/TV) store the refresh token in OS keychain (iOS Keychain · Android Keystore · macOS Keychain · libsecret · WinCred).&#10;Offline JWT verification means an in-flight watch session keeps playing through API restarts; revocation enforces on next refresh." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#475569;fontSize=11;align=left;spacingLeft=10;spacingTop=8;verticalAlign=top;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="40" y="1200" width="1920" height="80" as="geometry" />
        </mxCell>

        <mxCell id="numLegend" value="Numbered flow: ① TLS handshake → ② login (rate-limited) → ③ argon2id + JWT mint → ④ refresh + cookie/web_session writes → ⑤ audit log → ⑥ client uses signed URL on /stream → ⑦ Streaming verifies JWT OFFLINE against cached JWKS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;fontSize=11;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="40" y="1290" width="1920" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
