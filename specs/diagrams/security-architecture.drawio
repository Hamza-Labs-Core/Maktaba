<mxfile host="app.diagrams.net" agent="Maktaba Architecture" version="24.0.0">
  <diagram id="security" name="Security Architecture">
    <mxGraphModel dx="2000" dy="1300" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Maktaba — Security Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2A44" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1920" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="JWT minting, validation, signed URLs, streaming auth · Trust boundaries between services · CORS / TLS / HSTS · Rate-limit + lockout" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=13;fontColor=#475569" vertex="1" parent="1">
          <mxGeometry x="40" y="55" width="1920" height="22" as="geometry" />
        </mxCell>

        <!-- TRUST BOUNDARY: untrusted internet -->
        <mxCell id="tbInet" value="UNTRUSTED — Public Internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#991B1B;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;dashed=1;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="1920" height="200" as="geometry" />
        </mxCell>

        <mxCell id="webUser" value="Web user&#10;(browser)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#991B1B;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="100" y="160" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="mobileUser" value="Mobile / Desktop&#10;(Capacitor / Tauri)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#991B1B;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="260" y="160" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="tvUser" value="TV (tvOS / AndroidTV)&#10;native bearer JWT" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#991B1B;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="450" y="160" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apiClient" value="3rd-party API client&#10;PAT (personal_access_token)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#991B1B;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="660" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="threatActor" value="Threat actor&#10;XSS / CSRF / brute-force&#10;leaked URL replay" style="rectangle;whiteSpace=wrap;html=1;fillColor=#FCA5A5;strokeColor=#991B1B;fontSize=11;dashed=1" vertex="1" parent="1">
          <mxGeometry x="900" y="160" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="threatNotes" value="Mitigations enforced at perimeter (Caddy + API middleware):&#10;• TLS 1.3 only · HSTS max-age=63072000; includeSubDomains; preload · OCSP stapling · cipher allow-list&#10;• CORS allow-list (origin) on /api · CSRF double-submit token on web (state-changing methods)&#10;• Rate-limit: /api/auth/login 10/min/IP · /api/auth/* 30/min/IP · 30/min/IP general · 5 failed/15 min lockout&#10;• Argon2id pw_hash (m=64MB, t=3, p=4) · constant-time comparators · audit_log writes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#991B1B;fontSize=10;align=left;spacingLeft=10;spacingTop=6;verticalAlign=top;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="1140" y="135" width="800" height="115" as="geometry" />
        </mxCell>

        <!-- EDGE: Caddy / TLS -->
        <mxCell id="tbEdge" value="EDGE — TLS terminator + reverse proxy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#B45309;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="40" y="320" width="1920" height="120" as="geometry" />
        </mxCell>
        <mxCell id="caddy" value="Caddy / nginx&#10;TLS 1.3 · auto-cert · HSTS · OCSP staple&#10;X-Content-Type-Options: nosniff · Referrer-Policy · CSP · X-Frame-Options: DENY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="700" y="358" width="600" height="70" as="geometry" />
        </mxCell>

        <!-- TRUST BOUNDARY: Trusted backend -->
        <mxCell id="tbBack" value="TRUSTED — backend services (private LAN / docker network)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#166534;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1920" height="650" as="geometry" />
        </mxCell>

        <!-- API service block -->
        <mxCell id="apiSvc" value="&lt;b&gt;API Service (Go) — token issuer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E40AF;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="80" y="500" width="700" height="560" as="geometry" />
        </mxCell>

        <mxCell id="loginEP" value="POST /api/auth/login&#10;(username + password, argon2id verify)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="100" y="540" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="refreshEP" value="POST /api/auth/refresh&#10;(opaque refresh token, hashed in DB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="440" y="540" width="320" height="50" as="geometry" />
        </mxCell>

        <mxCell id="jwtMint" value="JWT MINTER (Epic 10 · plan-10-06 / 10-08)&#10;Algorithm: RS256 · 2048-bit key · key rotation via jwt_keys (kid)&#10;&#10;API access token (aud=api, 15 min):&#10;{ iss, aud=&quot;api&quot;, sub, iat, exp, jti, kid, is_admin, library_ids[] }&#10;&#10;Streaming session token (aud=streaming, expires_at):&#10;{ aud=&quot;streaming&quot;, sub, exp, jti, sid (session_id), lib=[res_lib] }&#10;&#10;Streaming direct-play (aud=streaming-direct):&#10;{ aud=&quot;streaming-direct&quot;, sub, exp, jti, vid, lib=[res_lib] }&#10;&#10;Streaming static (aud=streaming-static — posters/sprites/subs):&#10;{ aud=&quot;streaming-static&quot;, sub, exp, jti, vid, lib=[res_lib] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=10;align=left;spacingLeft=10;spacingTop=8;arcSize=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="100" y="610" width="660" height="220" as="geometry" />
        </mxCell>

        <mxCell id="jwks" value="GET /.well-known/jwks.json&#10;Public key set (no secret) · cache-control: 1 h&#10;Streaming + clients fetch this to verify offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="660" height="60" as="geometry" />
        </mxCell>

        <mxCell id="cookieAuth" value="Web cookie session (web only)&#10;httpOnly · Secure · SameSite=Lax · CSRF double-submit&#10;web_sessions row · revocable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="100" y="930" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bearerAuth" value="Bearer access JWT (native)&#10;15-min RS256 · refresh_tokens (sha256 hash)&#10;device_id binding · refresh family rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="440" y="930" width="320" height="60" as="geometry" />
        </mxCell>

        <mxCell id="patAuth" value="PAT for API automation&#10;personal_access_tokens · scoped · revocable · sha256-hashed&#10;rate-limited per-token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="100" y="1000" width="320" height="50" as="geometry" />
        </mxCell>
        <mxCell id="acl" value="library_acl + LibrariesForUser(user_id)&#10;(viewer/curator/admin) — checked on every request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="440" y="1000" width="320" height="50" as="geometry" />
        </mxCell>

        <!-- Streaming service block -->
        <mxCell id="streamSvc" value="&lt;b&gt;Streaming Service (Go) — verifies offline&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#166534;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=8;arcSize=4" vertex="1" parent="1">
          <mxGeometry x="800" y="500" width="650" height="560" as="geometry" />
        </mxCell>

        <mxCell id="signedMW" value="Signed-URL middleware (Epic 8 · plan-08-01 / Epic 23 · plan-23-02)&#10;1. Parse ?token= from query (or Bearer header)&#10;2. Decode JWT header → kid → cached public key (JWKS, 60 s ttl)&#10;3. Verify RS256 signature offline (no API roundtrip)&#10;4. Validate iss, aud (whitelist per route), exp, nbf, iat&#10;5. Check lib claim — only the resource's library_id&#10;6. Check session_id (sid) for /stream/{session}/* — must match streaming_sessions row" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#166534;fontSize=10;align=left;spacingLeft=10;spacingTop=8;arcSize=8;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="610" height="160" as="geometry" />
        </mxCell>

        <mxCell id="audMatrix" value="Audience → Route allowlist&#10;&#10;aud=streaming         → /stream/{sid}/manifest.* · /stream/{sid}/{rendition}/* · /stream/{sid}/subs/*&#10;aud=streaming-direct  → /stream/direct/{video_id} (range 206)&#10;aud=streaming-static  → /stream/posters/* · /stream/sprites/* · /stream/{sid}/subs/*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#166534;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="820" y="710" width="610" height="120" as="geometry" />
        </mxCell>

        <mxCell id="ffmpeg" value="FFmpeg subprocess pool (per session_id pinned)&#10;Read media volume (ro) · write to streaming cache (LRU)&#10;Subprocess sandboxed: no network, no /etc, ulimit cpu/mem&#10;CloseSession (gRPC) → SIGTERM → cleanup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#166534;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="820" y="850" width="610" height="80" as="geometry" />
        </mxCell>

        <mxCell id="grpcMtls" value="gRPC channel (API ↔ Streaming, API ↔ Pipeline)&#10;Loopback / docker-internal only · optional mTLS (Epic 23)&#10;Bound to 127.0.0.1 outside compose; no external listener" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E7FF;strokeColor=#1E40AF;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="820" y="950" width="610" height="80" as="geometry" />
        </mxCell>

        <!-- DB / secrets -->
        <mxCell id="dbBlock" value="&lt;b&gt;Postgres / SQLite&lt;/b&gt;&#10;TLS in transit (sslmode=verify-full)&#10;at-rest: filesystem encryption&#10;jwt_keys: private_pem encrypted with libsodium secretbox" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FEF9C3;strokeColor=#854D0E;fontSize=11;align=center" vertex="1" parent="1">
          <mxGeometry x="1480" y="540" width="450" height="100" as="geometry" />
        </mxCell>

        <mxCell id="secretsBox" value="Secrets (env / docker secrets / file mode 0400)&#10;• JWT_SIGNING_KEY (per kid) · ROTATION every 90 d&#10;• POSTGRES_PASSWORD · CADDY_TLS_KEY&#10;• OPENAI_API_KEY (Pipeline only) · SENTRY_DSN&#10;• Initial admin token (single-user bootstrap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#854D0E;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="1480" y="660" width="450" height="100" as="geometry" />
        </mxCell>

        <mxCell id="auditBox" value="audit_log (partitioned by month)&#10;categories: library | security | device | admin&#10;Security events: login.success/fail · refresh.replay-detected · pat.created · jwt_keys.rotated · stream.signed-url-mint&#10;dedupe_key for once-per-window write reduction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#854D0E;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="1480" y="780" width="450" height="120" as="geometry" />
        </mxCell>

        <mxCell id="rateLimit" value="Rate-limit + brute-force lockout (Epic 7 · plan-07-19 + Epic 23 · plan-23-06)&#10;• /api/auth/login: 10/min/IP — sliding-window in Postgres&#10;• /api/auth/*: 30/min/IP&#10;• Per-user fail counter: 5 in 15 min → 15 min lockout · audit_log entry&#10;• /api/* general: 30/min/IP · /stream: signed-URL exp acts as throttle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#854D0E;fontSize=10;align=left;spacingLeft=10;spacingTop=6;arcSize=8" vertex="1" parent="1">
          <mxGeometry x="1480" y="920" width="450" height="120" as="geometry" />
        </mxCell>

