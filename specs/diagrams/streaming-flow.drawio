        </mxCell>

        <mxCell id="e_grpc" value="gRPC OpenSession" style="endArrow=classic;html=1;curved=0;strokeColor=#9673a6;fontSize=11;fontStyle=1;" edge="1" parent="1" source="api_grpc_open" target="stream_session_lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e_resp" value="{session_id, manifest_url, expires_at}" style="endArrow=classic;html=1;curved=0;dashed=1;fontSize=10;" edge="1" parent="1" source="api_signurl" target="edge_caddy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Client → Streaming directly for manifest -->
        <mxCell id="e_play" value="GET manifest.m3u8 (signed JWT)" style="endArrow=classic;html=1;curved=0;strokeColor=#b85450;fontSize=11;fontStyle=1;" edge="1" parent="1" source="client_web" target="stream_jwt">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Streaming internal flow -->
        <mxCell id="es1" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="stream_jwt" target="stream_session_lookup">
