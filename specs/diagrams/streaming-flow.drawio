        <mxCell id="delivery_subs" value="GET /stream/{session}/subs/{lang}.vtt&#10;→ live-rendered from DB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="stream_swim">
          <mxGeometry x="700" y="430" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="delivery_direct" value="GET /stream/direct/{video_id}&#10;→ 206 Partial Content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="stream_swim">
          <mxGeometry x="700" y="480" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="delivery_static" value="GET /stream/posters/{id}.jpg · /stream/sprites/{id}.{webp,vtt}&#10;→ static, no session" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="stream_swim">
          <mxGeometry x="290" y="530" width="790" height="40" as="geometry" />
        </mxCell>

        <!-- ============ POSTGRES ============ -->
        <mxCell id="pg" value="PostgreSQL 16&#10;videos · media_info · audio_tracks&#10;streaming_sessions · playback_state&#10;LISTEN/NOTIFY: playback.progress" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1580" y="80" width="260" height="200" as="geometry" />
