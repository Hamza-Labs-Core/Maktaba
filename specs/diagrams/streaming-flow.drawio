        </mxCell>

        <!-- ffmpeg → manifest writer -->
        <mxCell id="es12" value="seg-N.ts (per rendition)" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stream_swim" source="ffmpeg_pool" target="manifest_writer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es13" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="manifest_writer" target="subs_pipeline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ffmpeg + manifest → cache_hls -->
        <mxCell id="es14" value="writes" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="stream_swim" source="ffmpeg_pool" target="cache_hls">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cache → delivery -->
        <mxCell id="es15" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="cache_hls" target="delivery_manifest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es16" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="cache_hls" target="delivery_seg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es17" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="subs_pipeline" target="delivery_subs">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es18" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="mode_direct" target="delivery_direct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es19" style="endArrow=classic;html=1;" edge="1" parent="stream_swim" source="cache_posters" target="delivery_static">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ffmpeg ← media volume -->
        <mxCell id="es20" value="raw bytes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="stream_swim" source="media_vol" target="ffmpeg_pool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es21" value="byte ranges" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="stream_swim" source="media_vol" target="mode_direct">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Sessions DB -->
        <mxCell id="es22" value="upsert" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="stream_swim" source="stream_session_lookup" target="session_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es23" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="stream_swim" source="ffmpeg_pool" target="session_store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Subs DB read -->
        <mxCell id="es24" value="reads transcript_segments" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="subs_auto" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Pipeline writes posters/sprites -->
        <mxCell id="es25" value="writes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="pipe_thumb" target="cache_posters">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Player → progress -->
        <mxCell id="es26" value="POST progress every 10 s" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="client_web" target="api_progress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="es27" value="UPDATE playback_state · NOTIFY" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="1" source="api_progress" target="pg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontStyle=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="900" height="160" as="geometry" />
        </mxCell>
        <mxCell id="legend_text" value="• Solid arrows: synchronous request/response&#10;• Dashed arrows: read/write to a state surface (DB, cache, file)&#10;• Diamonds: capability decisions in the streaming origin&#10;• Tier swimlanes: client · API (Go) · Streaming (Go) · Postgres / cache&#10;• JWT verification at Streaming is OFFLINE against the API's JWKS — API can be down without breaking in-flight playback&#10;• Sticky session: session_id pins one FFmpeg subprocess so adaptive switching keeps monotonic segment numbers" style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="860" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
