        </mxCell>
        <mxCell id="subs_sidecar" value="Sidecar SRT/VTT&#10;{name}.{lang}.srt&#10;converted to VTT,&#10;cached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="subs_pipeline">
          <mxGeometry x="190" y="40" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="subs_embedded" value="Embedded in container&#10;ffmpeg -map 0:s:N&#10;-c:s webvtt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="subs_pipeline">
          <mxGeometry x="360" y="40" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="subs_mux" value="VTT mux into HLS&#10;#EXT-X-MEDIA:TYPE=SUBTITLES&#10;GROUP-ID=&quot;subs&quot; · per-lang m3u8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="subs_pipeline">
          <mxGeometry x="20" y="140" width="500" height="60" as="geometry" />
        </mxCell>

        <!-- Session store -->
        <mxCell id="session_store" value="streaming_sessions (PG)&#10;session_id · video_id&#10;client_profile · transcoder_pid&#10;last_segment_fetch_at&#10;reaper: stale &gt; 90 s" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="stream_swim">
          <mxGeometry x="1500" y="40" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- ============ CACHE LAYERS ============ -->
        <mxCell id="cache_swim" value="Cache layers · /var/maktaba/cache/streaming/" style="swimlane;startSize=22;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=11;" vertex="1" parent="stream_swim">
          <mxGeometry x="1760" y="40" width="540" height="580" as="geometry" />
