        </mxCell>
        <mxCell id="cache_direct" value="direct/&#10;transient buffers&#10;range serves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="cache_swim">
          <mxGeometry x="280" y="160" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cache_posters" value="posters/{hash[:2]}/{hash}.jpg&#10;pre-generated by Pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="cache_swim">
