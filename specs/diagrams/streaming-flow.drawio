          <mxGeometry x="270" y="140" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="api_progress" value="POST /api/stream/sessions/{id}/progress&#10;{position_sec, completed?}&#10;writes playback_state · WS fan-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="api_swim">
