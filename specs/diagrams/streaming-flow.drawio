          <mxGeometry x="40" y="280" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Mode 2: Remux -->
        <mxCell id="mode_remux" value="Direct stream (remux)&#10;ffmpeg -c copy&#10;MKV→fMP4 / AVI→MP4&#10;low CPU, no quality loss" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="stream_swim">
          <mxGeometry x="290" y="280" width="200" height="100" as="geometry" />
        </mxCell>

        <!-- Mode 3: Transcode -->
        <mxCell id="mode_transcode" value="HLS / DASH transcode&#10;libx264 / videotoolbox /&#10;nvenc / qsv&#10;ladder: 1080p · 720p · 480p" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="stream_swim">
          <mxGeometry x="540" y="280" width="240" height="100" as="geometry" />
        </mxCell>

        <!-- FFmpeg pool -->
        <mxCell id="ffmpeg_pool" value="FFmpeg subprocess pool&#10;1 process per session (sticky)&#10;hwaccel auto-detect&#10;per-host semaphore (max_concurrent)&#10;-hls_time 4 -hls_list_size 6&#10;var_stream_map: v0/a0 v1/a0 v2/a0" style="shape=process;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="stream_swim">
          <mxGeometry x="820" y="160" width="320" height="220" as="geometry" />
        </mxCell>

        <!-- Manifest writer -->
        <mxCell id="manifest_writer" value="HLS / DASH manifest writer&#10;#EXT-X-VERSION:7&#10;#EXT-X-MEDIA AUDIO + SUBTITLES&#10;#EXT-X-STREAM-INF rungs&#10;#EXT-X-DATERANGE chapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="stream_swim">
          <mxGeometry x="1180" y="160" width="280" height="100" as="geometry" />
        </mxCell>

