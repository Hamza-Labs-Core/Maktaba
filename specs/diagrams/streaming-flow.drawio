        <mxCell id="stream_jwt" value="JWT verify (offline)&#10;RS256 against JWKS cache&#10;aud · exp · lib check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="stream_swim">
