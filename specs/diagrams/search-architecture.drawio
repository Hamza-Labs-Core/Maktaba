<mxfile host="app.diagrams.net" modified="2026-05-04T00:00:00.000Z" agent="Maktaba" version="24.7.0">
  <diagram id="search-architecture" name="Search Architecture">
    <mxGraphModel dx="2400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Search Architecture · Indexing Path + Query Path · BM25 + Semantic + RRF" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="40" as="geometry" />
        </mxCell>

        <!-- ====================================================================== -->
        <!-- INDEXING PATH (top half) -->
        <!-- ====================================================================== -->
        <mxCell id="idx_section" value="INDEXING PATH · transcript segments → chunks → FTS5 + embeddings → ChromaDB" style="swimlane;startSize=28;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="2320" height="560" as="geometry" />
        </mxCell>

        <!-- Source -->
        <mxCell id="idx_segments" value="transcript_segments&#10;(committed by STT loop)&#10;seq · start_sec · end_sec&#10;text · speaker · confidence" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="idx_section">
          <mxGeometry x="20" y="50" width="220" height="120" as="geometry" />
        </mxCell>

        <!-- Indexer -->
        <mxCell id="idx_indexer" value="Index stage (Pipeline)&#10;reads new segments since&#10;transcripts.last_indexed_segment_seq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="idx_section">
          <mxGeometry x="280" y="50" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Chunker -->
        <mxCell id="idx_chunker" value="Chunker → transcript_units&#10;1–3 sentences (~200 chars)&#10;sentence-boundary aware&#10;preserves segment_id offsets&#10;UNIQUE (transcript_id, seq)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="idx_section">
          <mxGeometry x="560" y="50" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Fan-out -->
        <mxCell id="idx_fanout" value="Fan-out per unit" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="idx_section">
          <mxGeometry x="840" y="80" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Lexical path -->
        <mxCell id="idx_fts_swim" value="Lexical path · FTS5 / tsvector" style="swimlane;startSize=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="idx_section">
          <mxGeometry x="1080" y="50" width="540" height="220" as="geometry" />
        </mxCell>
        <mxCell id="idx_fts_normalize" value="Normalize text&#10;Unicode NFC&#10;remove tatweel · diacritics&#10;lowercase Latin · keep Arabic shape" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="idx_fts_swim">
          <mxGeometry x="20" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="idx_fts_insert" value="UPSERT transcripts_fts&#10;(text, video_id UNINDEXED,&#10; transcript_id UNINDEXED,&#10; unit_id UNINDEXED, language)&#10;tokenize unicode61&#10;remove_diacritics 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="idx_fts_swim">
          <mxGeometry x="260" y="40" width="260" height="120" as="geometry" />
        </mxCell>
        <mxCell id="idx_fts_tsv" value="Postgres path: transcript_units.tsv (generated tsvector) + GIN index · arabic text-search config + pg_trgm for prefixes" style="text;html=1;align=left;fontSize=10;" vertex="1" parent="idx_fts_swim">
          <mxGeometry x="20" y="170" width="500" height="40" as="geometry" />
        </mxCell>

        <!-- Semantic path -->
        <mxCell id="idx_emb_swim" value="Semantic path · embeddings + ChromaDB" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="idx_section">
          <mxGeometry x="1660" y="50" width="640" height="450" as="geometry" />
        </mxCell>
        <mxCell id="idx_emb_model" value="Embedding model&#10;intfloat/multilingual-e5-large&#10;1024-dim · cosine&#10;device: mlx | cuda | cpu | auto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="idx_emb_swim">
          <mxGeometry x="20" y="40" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="idx_emb_batch" value="Batched embedding&#10;32 units / batch&#10;normalize L2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="idx_emb_swim">
          <mxGeometry x="320" y="40" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="idx_chroma" value="ChromaDB collection (per library)&#10;name: library-{library_id}&#10;metadata: {hnsw:space=cosine}&#10;col.add(&#10;  ids=[&quot;{transcript_id}:{seq}&quot;],&#10;  documents=[unit.text],&#10;  embeddings=[vec],&#10;  metadatas=[{video_id, start, end, language, speaker}])" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="idx_emb_swim">
          <mxGeometry x="20" y="170" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="idx_chroma_persist" value="ChromaDB on disk&#10;DuckDB+Parquet · embedded&#10;single-writer (Pipeline)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="idx_emb_swim">
          <mxGeometry x="20" y="350" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="idx_dlq" value="vector_index_dead_letter&#10;chroma write failures → DLQ row&#10;periodic re-drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="idx_emb_swim">
          <mxGeometry x="280" y="350" width="240" height="80" as="geometry" />
        </mxCell>

        <!-- Watermark advance -->
        <mxCell id="idx_watermark" value="UPDATE transcripts&#10;SET last_indexed_segment_seq = max(seq)&#10;UPDATE transcript_units&#10;SET indexed_at_in_chroma = now()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="idx_section">
          <mxGeometry x="280" y="320" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="idx_notify" value="NOTIFY 'transcripts.indexed'&#10;API fans out to /ws/library/{id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="idx_section">
          <mxGeometry x="640" y="320" width="320" height="80" as="geometry" />
        </mxCell>

        <mxCell id="idx_units_table" value="transcript_units (PG/SQLite)&#10;id · transcript_id · video_id · segment_id · seq&#10;start_sec · end_sec · text · language · tsv (generated)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="idx_section">
          <mxGeometry x="20" y="320" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="idx_legend" value="Triggers (SQLite) keep transcripts_fts populated automatically when transcript_units rows insert/update/delete.&#10;Postgres uses transcript_units.tsv generated column (no triggers).&#10;Both paths write the SAME unit text — chunking strategy is decoupled from STT segment boundaries so the indexer can re-chunk without rewriting STT outputs." style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="idx_section">
          <mxGeometry x="20" y="460" width="2280" height="80" as="geometry" />
        </mxCell>

        <!-- Indexing edges -->
        <mxCell id="ie1" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_segments" target="idx_indexer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie2" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_indexer" target="idx_chunker">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie3" value="writes" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="idx_section" source="idx_chunker" target="idx_units_table">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie4" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_chunker" target="idx_fanout">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie5" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_fanout" target="idx_fts_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie6" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_fanout" target="idx_emb_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie7" style="endArrow=classic;html=1;" edge="1" parent="idx_fts_swim" source="idx_fts_normalize" target="idx_fts_insert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie8" style="endArrow=classic;html=1;" edge="1" parent="idx_emb_swim" source="idx_emb_model" target="idx_emb_batch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie9" style="endArrow=classic;html=1;" edge="1" parent="idx_emb_swim" source="idx_emb_batch" target="idx_chroma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie10" style="endArrow=classic;html=1;" edge="1" parent="idx_emb_swim" source="idx_chroma" target="idx_chroma_persist">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie11" value="on failure" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="idx_emb_swim" source="idx_chroma" target="idx_dlq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie12" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_fts_swim" target="idx_watermark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie13" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_emb_swim" target="idx_watermark">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ie14" style="endArrow=classic;html=1;" edge="1" parent="idx_section" source="idx_watermark" target="idx_notify">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ====================================================================== -->
        <!-- QUERY PATH (bottom half) -->
        <!-- ====================================================================== -->
        <mxCell id="qry_section" value="QUERY PATH · POST /api/search · FTS5 (BM25) ⊕ ChromaDB (semantic) → RRF → ranked hits with timestamps" style="swimlane;startSize=28;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="2320" height="780" as="geometry" />
        </mxCell>

        <!-- Client query -->
        <mxCell id="qry_client" value="Client (Web · Mobile · TV)&#10;POST /api/search&#10;{q, mode, filters, limit}&#10;mode = fts | semantic | hybrid (default)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="qry_section">
          <mxGeometry x="20" y="50" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- API service -->
        <mxCell id="qry_api" value="API Service · search orchestrator&#10;parse filters (lang, library, type,&#10;duration, speaker, date range)&#10;permission filter via library_acl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_section">
          <mxGeometry x="340" y="50" width="280" height="100" as="geometry" />
        </mxCell>

        <!-- Mode dispatch -->
        <mxCell id="qry_mode" value="mode?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="qry_section">
          <mxGeometry x="660" y="80" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- BM25 lane -->
        <mxCell id="qry_bm25_swim" value="LEXICAL · FTS5 / tsvector + BM25" style="swimlane;startSize=22;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;fontStyle=1;" vertex="1" parent="qry_section">
          <mxGeometry x="20" y="200" width="900" height="240" as="geometry" />
        </mxCell>
        <mxCell id="qry_bm25_norm" value="Normalize query&#10;same NFC + diacritic strip&#10;quote-aware tokenization&#10;extract phrases / NEAR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_bm25_swim">
          <mxGeometry x="20" y="40" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="qry_bm25_run" value="SELECT … FROM transcripts_fts&#10;WHERE transcripts_fts MATCH ?&#10;ORDER BY bm25(transcripts_fts) ASC&#10;LIMIT 200&#10;(or PG: tsvector @@ tsquery ranked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=10;" vertex="1" parent="qry_bm25_swim">
          <mxGeometry x="240" y="40" width="320" height="120" as="geometry" />
        </mxCell>
        <mxCell id="qry_bm25_filter" value="Apply structured filters&#10;language · library · video.deleted_at IS NULL&#10;date range · duration · speaker_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_bm25_swim">
          <mxGeometry x="580" y="40" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="qry_bm25_out" value="Lexical hits&#10;[(unit_id, video_id, bm25_rank), …]&#10;score scale: implementation-defined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_bm25_swim">
          <mxGeometry x="240" y="170" width="620" height="50" as="geometry" />
        </mxCell>

        <!-- Semantic lane -->
        <mxCell id="qry_sem_swim" value="SEMANTIC · query embed → ChromaDB cosine top-K" style="swimlane;startSize=22;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="qry_section">
          <mxGeometry x="940" y="200" width="900" height="240" as="geometry" />
        </mxCell>
        <mxCell id="qry_sem_grpc" value="API → Pipeline gRPC&#10;Embed(text) → vector&#10;(query-time embedding)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="qry_sem_swim">
          <mxGeometry x="20" y="40" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="qry_sem_chroma" value="col.query(&#10;  query_embeddings=[vec],&#10;  n_results=200,&#10;  where={language|library|video_id})&#10;HNSW cosine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontFamily=Courier New;fontSize=10;" vertex="1" parent="qry_sem_swim">
          <mxGeometry x="260" y="40" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="qry_sem_postfilter" value="Post-filter join&#10;against PG (video.deleted_at, ACL)&#10;Chroma where covers metadata only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="qry_sem_swim">
          <mxGeometry x="560" y="40" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="qry_sem_out" value="Semantic hits&#10;[(unit_id, video_id, cosine_sim), …]&#10;score scale: 0..1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="qry_sem_swim">
          <mxGeometry x="260" y="170" width="580" height="50" as="geometry" />
        </mxCell>

        <!-- RRF fusion -->
        <mxCell id="qry_rrf" value="Reciprocal Rank Fusion&#10;score(d) = w_fts · 1/(k+rank_fts(d)) + w_sem · 1/(k+rank_sem(d))&#10;defaults: w_fts=0.5, w_sem=0.5, k=60&#10;tunable per user / per request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="qry_section">
          <mxGeometry x="240" y="480" width="600" height="120" as="geometry" />
        </mxCell>

        <!-- Filter and group -->
        <mxCell id="qry_groupby" value="Group by video_id · keep top N matches per video&#10;preserves segment timestamps for deep-link" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="qry_section">
          <mxGeometry x="900" y="480" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Hydrate -->
        <mxCell id="qry_hydrate" value="Hydrate result rows&#10;join videos · transcript_segments · speakers&#10;render snippet with &lt;mark&gt; from FTS offsets&#10;include start_sec / end_sec / speaker name" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="qry_section">
          <mxGeometry x="1340" y="480" width="500" height="120" as="geometry" />
        </mxCell>

        <!-- Response -->
        <mxCell id="qry_response" value="Response&#10;{ took_ms, total, hits: [&#10;  { video_id, title, language, score,&#10;    matches: [{ segment_id, start_sec, end_sec, text (with &lt;mark&gt;), speaker }] }&#10;], next: cursor }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="qry_section">
          <mxGeometry x="20" y="640" width="700" height="120" as="geometry" />
        </mxCell>

        <!-- Suggest -->
        <mxCell id="qry_suggest" value="Typeahead · GET /api/search/suggest?q=…&#10;reads search_suggestion_terms&#10;corpus = saved_searches + speakers + ngrams&#10;separate path; no FTS/Chroma fan-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_section">
          <mxGeometry x="760" y="640" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Saved searches -->
        <mxCell id="qry_saved" value="Saved searches · POST /api/search/save&#10;saved_searches.kind = fts | semantic | hybrid&#10;query JSON snapshot for replay&#10;Smart Collections: saved query stored on collections.smart_query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="qry_section">
          <mxGeometry x="1180" y="640" width="500" height="120" as="geometry" />
        </mxCell>

        <!-- Stores referenced -->
        <mxCell id="qry_pg" value="PostgreSQL / SQLite&#10;transcripts_fts · transcript_units · transcript_segments · videos · library_acl · saved_searches" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="qry_section">
          <mxGeometry x="1900" y="220" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="qry_chroma" value="ChromaDB on disk&#10;collection per library&#10;HNSW cosine · 1024 dim&#10;DuckDB+Parquet" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="qry_section">
          <mxGeometry x="1900" y="370" width="380" height="120" as="geometry" />
        </mxCell>

        <!-- Query edges -->
        <mxCell id="qe1" value="REST" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="qry_section" source="qry_client" target="qry_api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe2" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_api" target="qry_mode">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe3" value="fts | hybrid" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="qry_section" source="qry_mode" target="qry_bm25_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe4" value="semantic | hybrid" style="endArrow=classic;html=1;fontSize=10;" edge="1" parent="qry_section" source="qry_mode" target="qry_sem_swim">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="qe5" style="endArrow=classic;html=1;" edge="1" parent="qry_bm25_swim" source="qry_bm25_norm" target="qry_bm25_run">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe6" style="endArrow=classic;html=1;" edge="1" parent="qry_bm25_swim" source="qry_bm25_run" target="qry_bm25_filter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe7" style="endArrow=classic;html=1;" edge="1" parent="qry_bm25_swim" source="qry_bm25_filter" target="qry_bm25_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="qe8" style="endArrow=classic;html=1;" edge="1" parent="qry_sem_swim" source="qry_sem_grpc" target="qry_sem_chroma">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe9" style="endArrow=classic;html=1;" edge="1" parent="qry_sem_swim" source="qry_sem_chroma" target="qry_sem_postfilter">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe10" style="endArrow=classic;html=1;" edge="1" parent="qry_sem_swim" source="qry_sem_postfilter" target="qry_sem_out">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="qe11" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_bm25_swim" target="qry_rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe12" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_sem_swim" target="qry_rrf">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe13" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_rrf" target="qry_groupby">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe14" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_groupby" target="qry_hydrate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="qe15" style="endArrow=classic;html=1;" edge="1" parent="qry_section" source="qry_hydrate" target="qry_response">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="qe16" value="reads" style="endArrow=classic;html=1;dashed=1;fontSize=10;" edge="1" parent="qry_section" source="qry_bm25_run" target="qry_pg">
